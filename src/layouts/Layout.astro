---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:4040';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Premium Women's Fashion" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | YourShop</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="font-sans text-gray-800 antialiased bg-background">

		<!-- Announcement bar -->
		<div id="announcement-bar" class="bg-gradient-to-r from-orange-500 to-amber-400 text-white text-xs py-2 px-4 text-center relative">
			<span id="announcement-text">Free Shipping on orders above ₹1500</span>
			<button
				id="close-announcement"
				aria-label="Dismiss"
				class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white transition-colors leading-none"
				onclick="dismissAnnouncement()"
			>✕</button>
		</div>

		<Header />
		<slot />
		<Footer />

		<!-- Back to top button -->
		<button
			id="back-to-top"
			aria-label="Back to top"
			onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
			class="fixed bottom-6 left-4 z-50 bg-orange-600 hover:bg-orange-700 text-white rounded-full p-3 shadow-lg transition-all duration-200 opacity-0 pointer-events-none"
		>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
			</svg>
		</button>

		<!-- WhatsApp floating button -->
		<a
			id="whatsapp-float"
			href="#"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Chat on WhatsApp"
			class="fixed bottom-6 right-4 z-50 bg-green-500 hover:bg-green-600 text-white rounded-full p-3.5 shadow-lg transition-colors hidden"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
				<path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.555 4.116 1.528 5.845L.057 23.571a.5.5 0 00.614.635l5.878-1.539A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75A9.748 9.748 0 012.25 12 9.748 9.748 0 0112 2.25 9.748 9.748 0 0121.75 12 9.748 9.748 0 0112 21.75z"/>
			</svg>
		</a>

		<script is:inline define:vars={{ apiUrl }}>
			// Announcement bar
			function dismissAnnouncement() {
				const bar = document.getElementById('announcement-bar');
				if (bar) bar.style.display = 'none';
				sessionStorage.setItem('announcement-dismissed', '1');
			}

			if (sessionStorage.getItem('announcement-dismissed')) {
				const bar = document.getElementById('announcement-bar');
				if (bar) bar.style.display = 'none';
			}

			// Load settings for announcement text + WhatsApp
			fetch(`${apiUrl}/api/public/settings`)
				.then(r => r.ok ? r.json() : null)
				.then(data => {
					if (!data) return;
					const policies = data.policies;
					const site = data.site;
					const social = data.social;

					if (policies?.freeShippingAbove) {
						const el = document.getElementById('announcement-text');
						if (el) el.textContent = `Free Shipping on orders above ₹${policies.freeShippingAbove}`;
					}

					const waNumber = social?.whatsapp || site?.whatsappNumber;
					if (waNumber) {
						const btn = document.getElementById('whatsapp-float');
						if (btn) {
							const cleaned = waNumber.replace(/\D/g, '');
							btn.href = `https://wa.me/${cleaned}`;
							btn.classList.remove('hidden');
						}
					}
				})
				.catch(() => {});

			// Back to top
			const backToTop = document.getElementById('back-to-top');
			window.addEventListener('scroll', () => {
				if (!backToTop) return;
				if (window.scrollY > 400) {
					backToTop.classList.remove('opacity-0', 'pointer-events-none');
					backToTop.classList.add('opacity-100');
				} else {
					backToTop.classList.add('opacity-0', 'pointer-events-none');
					backToTop.classList.remove('opacity-100');
				}
			}, { passive: true });
		</script>
	</body>
</html>


