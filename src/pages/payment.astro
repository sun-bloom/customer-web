---
import Layout from "../layouts/Layout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";
---

<Layout title='Payment - Sunbloom Adorn'>
  <style>
    @keyframes shimmer {
      0% {
        background-position: -800px 0;
      }
      100% {
        background-position: 800px 0;
      }
    }
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 800px 100%;
      animation: shimmer 1.4s infinite linear;
      border-radius: 4px;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
    .spinner {
      width: 20px;
      height: 20px;
      border: 2px solid #ffffff40;
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: inline-block;
    }
    @keyframes pulse-ring {
      0% {
        transform: scale(0.8);
        opacity: 1;
      }
      100% {
        transform: scale(2);
        opacity: 0;
      }
    }
    .pulse-ring {
      animation: pulse-ring 1.5s ease-out infinite;
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .fade-in-up {
      animation: fadeInUp 0.4s ease forwards;
    }
    .timer-ring-circle {
      transition: stroke-dashoffset 1s linear;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
  </style>

  <div class='container mx-auto px-4 py-8'>
    <div id="main-container" class='max-w-4xl mx-auto'>
      <h1 class='text-3xl font-bold mb-8'>Complete Payment</h1>

      <!-- Skeleton loader -->
      <div id='payment-skeleton'>
        <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>
          <div class='bg-white rounded-lg shadow-md p-6 space-y-4'>
            <div class='skeleton h-6 w-40 mb-6'></div>
            <div class='grid grid-cols-2 gap-4'>
              {
                [1, 2, 3, 4].map(() => (
                  <div class='space-y-1'>
                    <div class='skeleton h-4 w-24' />
                    <div class='skeleton h-10 w-full rounded-md' />
                  </div>
                ))
              }
            </div>
            <div class='space-y-1'>
              <div class='skeleton h-4 w-32'></div>
              <div class='skeleton h-20 w-full rounded-md'></div>
            </div>
            <div class='grid grid-cols-2 gap-4'>
              {
                [1, 2].map(() => (
                  <div class='space-y-1'>
                    <div class='skeleton h-4 w-16' />
                    <div class='skeleton h-10 w-full rounded-md' />
                  </div>
                ))
              }
            </div>
          </div>
          <div class='bg-white rounded-lg shadow-md p-6'>
            <div class='skeleton h-6 w-36 mb-4'></div>
            {
              [1, 2, 3].map(() => (
                <div class='flex items-center gap-3 py-3 border-b border-gray-100'>
                  <div class='skeleton w-16 h-16 rounded-md flex-shrink-0' />
                  <div class='flex-1 space-y-2'>
                    <div class='skeleton h-4 w-full' />
                    <div class='skeleton h-3 w-24' />
                    <div class='skeleton h-4 w-16' />
                  </div>
                </div>
              ))
            }
            <div class='skeleton h-12 w-full rounded-md mt-6'></div>
          </div>
        </div>
      </div>

      <!-- Empty cart -->
      <div
        id='payment-empty-cart'
        class='hidden bg-white rounded-lg shadow-md p-8 text-center'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='mx-auto h-16 w-16 text-gray-400 mb-4'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z'
          ></path>
        </svg>
        <h2 class='text-xl font-medium text-gray-900 mb-2'>
          Your cart is empty
        </h2>
        <p class='text-gray-500 mb-6'>
          Looks like you haven't added anything to your cart yet.
        </p>
        <a
          href='/products'
          class='inline-block bg-amber-500 text-white py-2 px-6 rounded-md font-medium hover:bg-amber-600 transition-colors'
        >
          Continue Shopping
        </a>
      </div>

      <!-- Payment content -->
      <div
        id='payment-cart-container'
        class='hidden'
      >
        <div class='grid grid-cols-1 lg:grid-cols-2 gap-8'>
          <!-- Left: Customer details -->
          <div class='space-y-6'>
            <div class='bg-white rounded-lg shadow-md p-6'>
              <h2 class='text-xl font-semibold mb-6'>Your Details</h2>
              <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
                <div>
                  <label
                    for='customer-name'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >Full Name *</label
                  >
                  <input
                    type='text'
                    id='customer-name'
                    required
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                </div>
                <div>
                  <label
                    for='customer-phone'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >Phone Number *</label
                  >
                  <input
                    type='tel'
                    id='customer-phone'
                    required
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                </div>
                <div>
                  <label
                    for='customer-email'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >Email Address *</label
                  >
                  <input
                    type='email'
                    id='customer-email'
                    required
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                </div>
                <div>
                  <label
                    for='pincode'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >Pincode *</label
                  >
                  <input
                    type='text'
                    id='pincode'
                    required
                    maxlength='6'
                    pattern='[0-9]{6}'
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                  <div
                    id='pincode-status'
                    class='mt-1'
                  >
                  </div>
                </div>
              </div>
              <div class='mt-4'>
                <label
                  for='delivery-address'
                  class='block text-sm font-medium text-gray-700 mb-1'
                  >Delivery Address *</label
                >
                <textarea
                  id='delivery-address'
                  rows='3'
                  required
                  class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                ></textarea>
              </div>
              <div class='grid grid-cols-1 md:grid-cols-2 gap-4 mt-4'>
                <div>
                  <label
                    for='city'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >City *</label
                  >
                  <input
                    type='text'
                    id='city'
                    required
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                </div>
                <div>
                  <label
                    for='state'
                    class='block text-sm font-medium text-gray-700 mb-1'
                    >State *</label
                  >
                  <input
                    type='text'
                    id='state'
                    required
                    class='w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900'
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Order summary + UPI -->
          <div>
            <div class='bg-white rounded-lg shadow-md p-6 sticky top-6'>
              <h2 class='text-xl font-semibold mb-4'>Order Summary</h2>

              <div
                id='payment-cart-items'
                class='space-y-3 mb-4'
              >
              </div>

              <div class='space-y-2 pb-4 border-b'>
                <div class='flex justify-between text-sm text-gray-600'>
                  <span>Subtotal</span>
                  <span
                    id='payment-subtotal'
                    class='font-medium text-gray-900'
                    >₹0</span
                  >
                </div>
                <div class='flex justify-between text-sm text-gray-600'>
                  <span>Shipping</span>
                  <span
                    id='payment-shipping'
                    class='font-medium text-gray-900'
                    >₹50</span
                  >
                </div>
              </div>

              <div class='pt-4 flex justify-between items-center mb-6'>
                <span class='text-lg font-semibold'>Total</span>
                <span
                  id='payment-total'
                  class='text-xl font-bold text-gray-900'
                  >₹0</span
                >
              </div>

              <!-- Error message -->
              <div
                id='payment-error'
                class='hidden mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-md text-sm'
              >
              </div>

              <!-- Stock error banner -->
              <div
                id='stock-error-banner'
                class='hidden mb-4 p-4 bg-amber-50 border border-amber-200 rounded-md'
              >
                <div class='flex items-start gap-2 mb-2'>
                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    class='h-5 w-5 text-amber-500 flex-shrink-0 mt-0.5'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                    ></path>
                  </svg>
                  <p class='text-sm font-semibold text-amber-800'>
                    Some items are unavailable
                  </p>
                </div>
                <ul
                  id='stock-error-list'
                  class='space-y-1 pl-7'
                >
                </ul>
                <a
                  href='/cart'
                  class='mt-3 inline-block text-xs font-medium text-amber-700 underline'
                  >← Update your cart</a
                >
              </div>

              <!-- Pay button -->
              <button
                id='pay-now-btn'
                class='w-full bg-amber-500 text-white py-3 px-6 rounded-md font-medium hover:bg-amber-600 transition-colors flex items-center justify-center gap-2 cursor-pointer'
              >
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='h-5 w-5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.243m-4.243 0L9 9m3 3l-3 3'
                  ></path>
                </svg>
                Pay with UPI
              </button>

              <!-- UPI QR section -->
              <div
                id='upi-payment-section'
                class='hidden mt-6'
              >
                <div class='border-t pt-6'>
                  <!-- Timer row -->
                  <div class='flex items-center justify-between mb-4'>
                    <p class='text-sm text-gray-500'>Scan QR to pay</p>
                    <div class='flex items-center gap-2'>
                      <svg
                        class='w-8 h-8'
                        viewBox='0 0 36 36'
                      >
                        <circle
                          cx='18'
                          cy='18'
                          r='15.9'
                          fill='none'
                          stroke='#e5e7eb'
                          stroke-width='3'
                        ></circle>
                        <circle
                          id='timer-ring'
                          cx='18'
                          cy='18'
                          r='15.9'
                          fill='none'
                          stroke='#111827'
                          stroke-width='3'
                          stroke-dasharray='100 100'
                          stroke-dashoffset='0'
                          stroke-linecap='round'
                          class='timer-ring-circle'
                        ></circle>
                      </svg>
                      <span
                        id='session-timer'
                        class='text-sm font-mono font-medium text-gray-700'
                        >15:00</span
                      >
                    </div>
                  </div>

                  <!-- QR Code -->
                  <div class='flex justify-center mb-4'>
                    <div
                      id='qr-wrapper'
                      class='p-3 border-2 border-gray-200 rounded-lg inline-block relative'
                    >
                      <img
                        id='upi-qr-image'
                        src=''
                        alt='UPI QR Code'
                        class='w-48 h-48'
                      />
                      <!-- Expired overlay -->
                      <div
                        id='qr-expired-overlay'
                        class='hidden absolute inset-0 bg-white/90 rounded-lg flex flex-col items-center justify-center'
                      >
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          class='h-10 w-10 text-red-400 mb-2'
                          fill='none'
                          viewBox='0 0 24 24'
                          stroke='currentColor'
                        >
                          <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            stroke-width='2'
                            d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'
                          ></path>
                        </svg>
                        <p class='text-sm font-medium text-gray-700'>
                          QR Expired
                        </p>
                        <button
                          id='refresh-qr-btn'
                          class='mt-2 text-xs bg-amber-500 text-white px-3 py-1.5 rounded-md hover:bg-amber-600 transition-colors'
                        >
                          Generate New QR
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- UPI App buttons — mobile only -->
                  <div
                    id='upi-app-buttons'
                    class='hidden mb-4'
                  >
                    <a
                      id='upi-pay-btn'
                      href='#'
                      class='flex items-center justify-center gap-2 w-full p-3 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium rounded-xl transition-colors'
                    >
                      <svg
                        viewBox='0 0 24 24'
                        class='w-5 h-5'
                        fill='none'
                        xmlns='http://www.w3.org/2000/svg'
                      >
                        <path
                          d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'
                          stroke='white'
                          stroke-width='2'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                        ></path>
                      </svg>
                      Pay with UPI App
                    </a>
                  </div>

                  <!-- Polling indicator -->
                  <div
                    id='polling-status'
                    class='flex items-center justify-center gap-2 mb-4'
                  >
                    <span class='relative flex h-2 w-2'>
                      <span
                        class='animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75'
                      ></span>
                      <span
                        class='relative inline-flex rounded-full h-2 w-2 bg-gray-500'
                      ></span>
                    </span>
                    <span class='text-xs text-gray-500'
                      >Waiting for payment…</span
                    >
                  </div>

                  <!-- Payment success banner -->
                  <div
                    id='payment-success-banner'
                    class='hidden fade-in-up bg-green-50 border border-green-200 rounded-lg p-5 text-center mb-4'
                  >
                    <div class='flex items-center justify-center mb-3'>
                      <div class='relative'>
                        <div
                          class='absolute inset-0 bg-green-300 rounded-full pulse-ring'
                        >
                        </div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          class='relative h-12 w-12 text-green-600'
                          fill='none'
                          viewBox='0 0 24 24'
                          stroke='currentColor'
                        >
                          <path
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            stroke-width='2'
                            d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
                          ></path>
                        </svg>
                      </div>
                    </div>
                    <p class='font-bold text-green-800 text-xl'>
                      Payment Successful!
                    </p>
                    <p class='text-sm text-green-600 mt-1'>
                      Saving your order, redirecting…
                    </p>
                  </div>

                  <!-- Payment failed banner -->
                  <div
                    id='payment-failed-banner'
                    class='hidden fade-in-up bg-red-50 border border-red-200 rounded-lg p-5 text-center mb-4'
                  >
                    <svg
                      xmlns='http://www.w3.org/2000/svg'
                      class='mx-auto h-12 w-12 text-red-500 mb-2'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2'
                        d='M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z'
                      ></path>
                    </svg>
                    <p class='font-bold text-red-800 text-xl'>Payment Failed</p>
                    <p class='text-sm text-red-600 mt-1'>
                      Your payment was not completed.
                    </p>
                    <div class='flex items-center justify-center gap-3 mt-3'>
                      <button
                        id='retry-payment-btn'
                        class='bg-amber-500 text-white text-sm px-5 py-2 rounded-md hover:bg-amber-600 transition-colors'
                      >
                        Check again
                      </button>
                      <button
                        id='cancel-order-btn'
                        class='bg-white text-red-600 border border-red-300 text-sm px-5 py-2 rounded-md hover:bg-red-50 transition-colors'
                      >
                        Cancel Order
                      </button>
                    </div>
                  </div>

                  <a
                    href='/cart'
                    class='block text-center text-sm text-gray-500 hover:text-black mt-2'
                    >← Back to Cart</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type='module' define:vars={{ apiUrl }}>
    document.addEventListener("DOMContentLoaded", async () => {
      let cartItems = [];
      let subtotal = 0;
      let shippingCharge = 50;
      let totalAmount = 0;
      let productsCatalog = { products: [] };
      let deliverySettings = { regions: [] };
      let upiDetails = { vpa: "", name: "" };
      let cashfreeOrderId = "";
      let paymentSessionId = "";
      let orderExpiryTime = null;
      let pollInterval = null;
      let timerInterval = null;
      let sessionExpired = false;
      let currentCustomer = null;
      let paymentDone = false; // guard — prevents duplicate success/fail triggers
      let orderNumber = "";

      const SESSION_DURATION = 15 * 60; // 15 min

      // ── Helpers ──────────────────────────────────────────────────────
      function show(id) {
        document.getElementById(id)?.classList.remove("hidden");
      }
      function hide(id) {
        document.getElementById(id)?.classList.add("hidden");
      }
      function $(id) {
        return document.getElementById(id);
      }
      function setText(id, val) {
        const el = $(id);
        if (el) el.textContent = val;
      }

      function showError(msg) {
        const el = $("payment-error");
        if (!el) return;
        el.textContent = msg;
        el.classList.remove("hidden");
        setTimeout(() => el.classList.add("hidden"), 6000);
      }

      function showStockErrors(stockErrors) {
        const banner = $("stock-error-banner");
        const list = $("stock-error-list");
        if (!banner || !list) return;
        list.innerHTML = stockErrors
          .map(
            (e) =>
              `<li class="text-sm text-amber-700">
            <span class="font-medium">${e.productName}</span>
            — ${e.reason}${e.available ? ` (${e.available} available)` : ""}
          </li>`,
          )
          .join("");
        banner.classList.remove("hidden");
        banner.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function setLoading(btnId, loading, label = "") {
        const btn = $(btnId);
        if (!btn) return;
        btn.disabled = loading;
        btn.innerHTML = loading
          ? `<span class="spinner"></span> Processing…`
          : label;
      }

      // ── Remote data ───────────────────────────────────────────────────
      async function fetchJson(endpoint) {
        const res = await fetch(`${apiUrl}${endpoint}`);
        if (!res.ok) return null;
        return res.json();
      }

      async function loadRemoteData() {
        const [productsData, settingsData, deliveryData] = await Promise.all([
          fetchJson("/api/products"),
          fetchJson("/api/public/settings"),
          fetchJson("/api/delivery"),
        ]);
        productsCatalog = {
          products: (productsData?.products || []).filter((p) => p.isActive),
        };
        deliverySettings = deliveryData || { regions: [] };
        upiDetails = settingsData?.upi || { vpa: "", name: "" };
      }

      // ── Cart ──────────────────────────────────────────────────────────
      function loadCart() {
        try {
          cartItems = JSON.parse(localStorage.getItem("cart") || "[]");
        } catch {
          cartItems = [];
        }
        if (cartItems.length === 0) {
          hide("payment-skeleton");
          show("payment-empty-cart");
          return;
        }
        hide("payment-skeleton");
        show("payment-cart-container");
        renderCartItems();
        updateTotals();
      }

      function renderCartItems() {
        const container = $("payment-cart-items");
        if (!container) return;
        subtotal = 0;
        container.innerHTML = "";
        cartItems.forEach((item) => {
          const product = productsCatalog.products.find(
            (p) => p.id === item.productId,
          );
          const variant = product?.variants?.find(
            (v) => v.id === item.variantId,
          );
          if (!product || !variant) return;
          const itemTotal = item.quantity * item.unitPrice;
          subtotal += itemTotal;
          const el = document.createElement("div");
          el.className =
            "flex items-center gap-3 py-2 border-b border-gray-100 last:border-0";
          el.innerHTML = `
            <img src="${item.productImage}" alt="${item.productName}" class="w-14 h-14 object-cover rounded-md flex-shrink-0" />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate">${item.productName}</p>
              <p class="text-xs text-gray-500">${item.color} / ${item.pattern} × ${item.quantity}</p>
              <p class="text-[11px] text-gray-400">SKU: ${variant.sku || '-'}</p>
              <p class="text-sm font-semibold text-gray-900">₹${itemTotal}</p>
            </div>
          `;
          container.appendChild(el);
        });
      }

      function updateTotals() {
        totalAmount = subtotal + shippingCharge;
        setText("payment-subtotal", `₹${subtotal}`);
        setText(
          "payment-shipping",
          shippingCharge === 0 ? "FREE" : `₹${shippingCharge}`,
        );
        setText("payment-total", `₹${totalAmount}`);
      }

      // ── Pincode ───────────────────────────────────────────────────────
      const FALLBACK_REGIONS = [
        {
          regionName: "Chennai",
          pincodeStart: "600001",
          pincodeEnd: "600130",
          deliveryCharge: 40,
          estimatedDays: 1,
          isEnabled: true,
        },
        {
          regionName: "Coimbatore",
          pincodeStart: "641001",
          pincodeEnd: "641110",
          deliveryCharge: 60,
          estimatedDays: 2,
          isEnabled: true,
        },
        {
          regionName: "Madurai",
          pincodeStart: "625001",
          pincodeEnd: "625030",
          deliveryCharge: 60,
          estimatedDays: 2,
          isEnabled: true,
        },
        {
          regionName: "Tiruchirappalli",
          pincodeStart: "620001",
          pincodeEnd: "620030",
          deliveryCharge: 60,
          estimatedDays: 2,
          isEnabled: true,
        },
        {
          regionName: "Salem",
          pincodeStart: "636001",
          pincodeEnd: "636030",
          deliveryCharge: 70,
          estimatedDays: 3,
          isEnabled: true,
        },
        {
          regionName: "Tirunelveli",
          pincodeStart: "627001",
          pincodeEnd: "627030",
