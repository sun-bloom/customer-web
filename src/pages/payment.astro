---
import Layout from '../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:4040';
---

<Layout title="Payment - Fashion Store">
  <style>
    @keyframes shimmer {
      0%   { background-position: -800px 0; }
      100% { background-position: 800px 0; }
    }
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 800px 100%;
      animation: shimmer 1.4s infinite linear;
      border-radius: 4px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 20px; height: 20px;
      border: 2px solid #ffffff40;
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: inline-block;
    }
    @keyframes pulse-ring {
      0%   { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2);   opacity: 0; }
    }
    .pulse-ring { animation: pulse-ring 1.5s ease-out infinite; }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up { animation: fadeInUp 0.4s ease forwards; }
    .timer-ring-circle {
      transition: stroke-dashoffset 1s linear;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
  </style>

  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold mb-8">Complete Payment</h1>

      <!-- Skeleton loader -->
      <div id="payment-skeleton">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="bg-white rounded-lg shadow-md p-6 space-y-4">
            <div class="skeleton h-6 w-40 mb-6"></div>
            <div class="grid grid-cols-2 gap-4">
              {[1,2,3,4].map(() => (
                <div class="space-y-1">
                  <div class="skeleton h-4 w-24"></div>
                  <div class="skeleton h-10 w-full rounded-md"></div>
                </div>
              ))}
            </div>
            <div class="space-y-1">
              <div class="skeleton h-4 w-32"></div>
              <div class="skeleton h-20 w-full rounded-md"></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              {[1,2].map(() => (
                <div class="space-y-1">
                  <div class="skeleton h-4 w-16"></div>
                  <div class="skeleton h-10 w-full rounded-md"></div>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <div class="skeleton h-6 w-36 mb-4"></div>
            {[1,2,3].map(() => (
              <div class="flex items-center gap-3 py-3 border-b border-gray-100">
                <div class="skeleton w-16 h-16 rounded-md flex-shrink-0"></div>
                <div class="flex-1 space-y-2">
                  <div class="skeleton h-4 w-full"></div>
                  <div class="skeleton h-3 w-24"></div>
                  <div class="skeleton h-4 w-16"></div>
                </div>
              </div>
            ))}
            <div class="skeleton h-12 w-full rounded-md mt-6"></div>
          </div>
        </div>
      </div>

      <!-- Empty cart -->
      <div id="payment-empty-cart" class="hidden bg-white rounded-lg shadow-md p-8 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h2 class="text-xl font-medium text-gray-900 mb-2">Your cart is empty</h2>
        <p class="text-gray-500 mb-6">Looks like you haven't added anything to your cart yet.</p>
        <a href="/products" class="inline-block bg-gray-900 text-white py-2 px-6 rounded-md font-medium hover:bg-black transition-colors">
          Continue Shopping
        </a>
      </div>

      <!-- Payment content -->
      <div id="payment-cart-container" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Left: Customer details -->
          <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-md p-6">
              <h2 class="text-xl font-semibold mb-6">Your Details</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="customer-name" class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                  <input type="text" id="customer-name" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                </div>
                <div>
                  <label for="customer-phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                  <input type="tel" id="customer-phone" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                </div>
                <div>
                  <label for="customer-email" class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label>
                  <input type="email" id="customer-email" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                </div>
                <div>
                  <label for="pincode" class="block text-sm font-medium text-gray-700 mb-1">Pincode *</label>
                  <input type="text" id="pincode" required maxlength="6" pattern="[0-9]{6}"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                  <div id="pincode-status" class="mt-1"></div>
                </div>
              </div>
              <div class="mt-4">
                <label for="delivery-address" class="block text-sm font-medium text-gray-700 mb-1">Delivery Address *</label>
                <textarea id="delivery-address" rows="3" required
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <div>
                  <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City *</label>
                  <input type="text" id="city" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                </div>
                <div>
                  <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State *</label>
                  <input type="text" id="state" required
                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-gray-900" />
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Order summary + UPI -->
          <div>
            <div class="bg-white rounded-lg shadow-md p-6 sticky top-6">
              <h2 class="text-xl font-semibold mb-4">Order Summary</h2>

              <div id="payment-cart-items" class="space-y-3 mb-4"></div>

              <div class="space-y-2 pb-4 border-b">
                <div class="flex justify-between text-sm text-gray-600">
                  <span>Subtotal</span>
                  <span id="payment-subtotal" class="font-medium text-gray-900">₹0</span>
                </div>
                <div class="flex justify-between text-sm text-gray-600">
                  <span>Shipping</span>
                  <span id="payment-shipping" class="font-medium text-gray-900">₹50</span>
                </div>
              </div>

              <div class="pt-4 flex justify-between items-center mb-6">
                <span class="text-lg font-semibold">Total</span>
                <span id="payment-total" class="text-xl font-bold text-gray-900">₹0</span>
              </div>

              <!-- Error message -->
              <div id="payment-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-md text-sm"></div>

              <!-- Pay button -->
              <button id="pay-now-btn"
                class="w-full bg-gray-900 text-white py-3 px-6 rounded-md font-medium hover:bg-black transition-colors flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.243m-4.243 0L9 9m3 3l-3 3" />
                </svg>
                Pay with UPI
              </button>

              <!-- UPI QR section -->
              <div id="upi-payment-section" class="hidden mt-6">
                <div class="border-t pt-6">

                  <!-- Timer row -->
                  <div class="flex items-center justify-between mb-4">
                    <p class="text-sm text-gray-500">Scan QR to pay</p>
                    <div class="flex items-center gap-2">
                      <svg class="w-8 h-8" viewBox="0 0 36 36">
                        <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e5e7eb" stroke-width="3"/>
                        <circle id="timer-ring" cx="18" cy="18" r="15.9" fill="none"
                          stroke="#111827" stroke-width="3"
                          stroke-dasharray="100 100"
                          stroke-dashoffset="0"
                          stroke-linecap="round"
                          class="timer-ring-circle"/>
                      </svg>
                      <span id="session-timer" class="text-sm font-mono font-medium text-gray-700">15:00</span>
                    </div>
                  </div>

                  <!-- QR Code -->
                  <div class="flex justify-center mb-4">
                    <div id="qr-wrapper" class="p-3 border-2 border-gray-200 rounded-lg inline-block relative">
                      <img id="upi-qr-image" src="" alt="UPI QR Code" class="w-48 h-48" />
                      <!-- Expired overlay -->
                      <div id="qr-expired-overlay" class="hidden absolute inset-0 bg-white/90 rounded-lg flex flex-col items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-sm font-medium text-gray-700">QR Expired</p>
                        <button id="refresh-qr-btn" class="mt-2 text-xs bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-black transition-colors">
                          Generate New QR
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Polling indicator -->
                  <div id="polling-status" class="flex items-center justify-center gap-2 mb-4">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-gray-500"></span>
                    </span>
                    <span class="text-xs text-gray-500">Waiting for payment…</span>
                  </div>

                  <!-- Payment success banner -->
                  <div id="payment-success-banner" class="hidden fade-in-up bg-green-50 border border-green-200 rounded-lg p-5 text-center mb-4">
                    <div class="flex items-center justify-center mb-3">
                      <div class="relative">
                        <div class="absolute inset-0 bg-green-300 rounded-full pulse-ring"></div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="relative h-12 w-12 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </div>
                    </div>
                    <p class="font-bold text-green-800 text-xl">Payment Successful!</p>
                    <p class="text-sm text-green-600 mt-1">Saving your order, redirecting…</p>
                  </div>

                  <!-- Payment failed banner -->
                  <div id="payment-failed-banner" class="hidden fade-in-up bg-red-50 border border-red-200 rounded-lg p-5 text-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-red-500 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="font-bold text-red-800 text-xl">Payment Failed</p>
                    <p class="text-sm text-red-600 mt-1">Your payment was not completed.</p>
                    <button id="retry-payment-btn" class="mt-3 bg-gray-900 text-white text-sm px-5 py-2 rounded-md hover:bg-black transition-colors">
                      Try Again
                    </button>
                  </div>

                  <a href="/cart" class="block text-center text-sm text-gray-500 hover:text-black mt-2">← Back to Cart</a>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script type="module" define:vars={{ apiUrl }}>
    document.addEventListener('DOMContentLoaded', async () => {
      let cartItems        = [];
      let subtotal         = 0;
      let shippingCharge   = 50;
      let totalAmount      = 0;
      let productsCatalog  = { products: [] };
      let deliverySettings = { regions: [] };
      let upiDetails       = { vpa: '', name: '' };
      let cashfreeOrderId  = '';
      let paymentSessionId = '';
      let pollInterval     = null;
      let timerInterval    = null;
      let sessionExpired   = false;
      let currentCustomer  = null;

      const SESSION_DURATION = 5 * 60; // 5 min

      // ── Helpers ──────────────────────────────────────────────────────
      function show(id)  { document.getElementById(id)?.classList.remove('hidden'); }
      function hide(id)  { document.getElementById(id)?.classList.add('hidden'); }
      function $(id)     { return document.getElementById(id); }
      function setText(id, val) { const el = $(id); if (el) el.textContent = val; }

      function showError(msg) {
        const el = $('payment-error');
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('hidden');
        setTimeout(() => el.classList.add('hidden'), 6000);
      }

      function setLoading(btnId, loading, label = '') {
        const btn = $(btnId);
        if (!btn) return;
        btn.disabled = loading;
        btn.innerHTML = loading ? `<span class="spinner"></span> Processing…` : label;
      }

      // ── Remote data ───────────────────────────────────────────────────
      async function fetchJson(endpoint) {
        const res = await fetch(`${apiUrl}${endpoint}`);
        if (!res.ok) return null;
        return res.json();
      }

      async function loadRemoteData() {
        const [productsData, settingsData, deliveryData] = await Promise.all([
          fetchJson('/api/products'),
          fetchJson('/api/public/settings'),
          fetchJson('/api/delivery'),
        ]);
        productsCatalog  = { products: (productsData?.products || []).filter(p => p.isActive) };
        deliverySettings = deliveryData || { regions: [] };
        upiDetails       = settingsData?.upi || { vpa: '', name: '' };
      }

      // ── Cart ──────────────────────────────────────────────────────────
      function loadCart() {
        try { cartItems = JSON.parse(localStorage.getItem('cart') || '[]'); }
        catch { cartItems = []; }
        if (cartItems.length === 0) {
          hide('payment-skeleton'); show('payment-empty-cart'); return;
        }
        hide('payment-skeleton');
        show('payment-cart-container');
        renderCartItems();
        updateTotals();
      }

      function renderCartItems() {
        const container = $('payment-cart-items');
        if (!container) return;
        subtotal = 0;
        container.innerHTML = '';
        cartItems.forEach(item => {
          const product = productsCatalog.products.find(p => p.id === item.productId);
          const variant = product?.variants?.find(v => v.id === item.variantId);
          if (!product || !variant) return;
          const itemTotal = item.quantity * item.unitPrice;
          subtotal += itemTotal;
          const el = document.createElement('div');
          el.className = 'flex items-center gap-3 py-2 border-b border-gray-100 last:border-0';
          el.innerHTML = `
            <img src="${item.productImage}" alt="${item.productName}" class="w-14 h-14 object-cover rounded-md flex-shrink-0" />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate">${item.productName}</p>
              <p class="text-xs text-gray-500">${item.color} / ${item.pattern} × ${item.quantity}</p>
              <p class="text-sm font-semibold text-gray-900">₹${itemTotal}</p>
            </div>
          `;
          container.appendChild(el);
        });
      }

      function updateTotals() {
        totalAmount = subtotal + shippingCharge;
        setText('payment-subtotal', `₹${subtotal}`);
        setText('payment-shipping', shippingCharge === 0 ? 'FREE' : `₹${shippingCharge}`);
        setText('payment-total',    `₹${totalAmount}`);
      }

      // ── Pincode ───────────────────────────────────────────────────────
      const FALLBACK_REGIONS = [
        { regionName: 'Chennai',         pincodeStart: '600001', pincodeEnd: '600130', deliveryCharge: 40,  estimatedDays: 1, isEnabled: true },
        { regionName: 'Coimbatore',      pincodeStart: '641001', pincodeEnd: '641110', deliveryCharge: 60,  estimatedDays: 2, isEnabled: true },
        { regionName: 'Madurai',         pincodeStart: '625001', pincodeEnd: '625030', deliveryCharge: 60,  estimatedDays: 2, isEnabled: true },
        { regionName: 'Tiruchirappalli', pincodeStart: '620001', pincodeEnd: '620030', deliveryCharge: 60,  estimatedDays: 2, isEnabled: true },
        { regionName: 'Salem',           pincodeStart: '636001', pincodeEnd: '636030', deliveryCharge: 70,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Tirunelveli',     pincodeStart: '627001', pincodeEnd: '627030', deliveryCharge: 70,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Erode',           pincodeStart: '638001', pincodeEnd: '638060', deliveryCharge: 70,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Vellore',         pincodeStart: '632001', pincodeEnd: '632060', deliveryCharge: 70,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Tiruppur',        pincodeStart: '641601', pincodeEnd: '641670', deliveryCharge: 60,  estimatedDays: 2, isEnabled: true },
        { regionName: 'Bengaluru',       pincodeStart: '560001', pincodeEnd: '560110', deliveryCharge: 70,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Mumbai',          pincodeStart: '400001', pincodeEnd: '400110', deliveryCharge: 90,  estimatedDays: 4, isEnabled: true },
        { regionName: 'Delhi',           pincodeStart: '110001', pincodeEnd: '110110', deliveryCharge: 90,  estimatedDays: 4, isEnabled: true },
        { regionName: 'Hyderabad',       pincodeStart: '500001', pincodeEnd: '500110', deliveryCharge: 80,  estimatedDays: 3, isEnabled: true },
        { regionName: 'Pune',            pincodeStart: '411001', pincodeEnd: '411060', deliveryCharge: 90,  estimatedDays: 4, isEnabled: true },
        { regionName: 'Kolkata',         pincodeStart: '700001', pincodeEnd: '700110', deliveryCharge: 100, estimatedDays: 5, isEnabled: true },
      ];

      function checkPincode() {
        const pincode  = $('pincode')?.value?.trim();
        const statusEl = $('pincode-status');
        if (!pincode || pincode.length !== 6 || !statusEl) return;
        const regions = deliverySettings.regions?.length > 0 ? deliverySettings.regions : FALLBACK_REGIONS;
        const num = parseInt(pincode);
        let found = false;
        for (const region of regions) {
          if (!region.isEnabled) continue;
          if (num >= parseInt(region.pincodeStart) && num <= parseInt(region.pincodeEnd)) {
            shippingCharge = region.deliveryCharge;
            statusEl.innerHTML = `<span class="text-green-600 text-xs">✓ ${region.regionName} — Delivery in ${region.estimatedDays} day${region.estimatedDays > 1 ? 's' : ''} · ₹${region.deliveryCharge} shipping</span>`;
            found = true;
            break;
          }
        }
        if (!found) statusEl.innerHTML = `<span class="text-red-600 text-xs">✗ Delivery not available for this pincode</span>`;
        updateTotals();
      }

      // ── Session timer ─────────────────────────────────────────────────
      function startSessionTimer() {
        let remaining = SESSION_DURATION;
        const timerEl = $('session-timer');
        const ring    = $('timer-ring');
        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          remaining--;
          const mins = String(Math.floor(remaining / 60)).padStart(2, '0');
          const secs = String(remaining % 60).padStart(2, '0');
          if (timerEl) timerEl.textContent = `${mins}:${secs}`;
          // Shrink ring stroke
          const offset = 100 - (remaining / SESSION_DURATION) * 100;
          if (ring) ring.style.strokeDashoffset = offset;
          // Red in last 2 mins
          if (remaining <= 120) {
            if (ring) ring.style.stroke = '#ef4444';
            timerEl?.classList.add('text-red-500');
            timerEl?.classList.remove('text-gray-700');
          }
          if (remaining <= 0) {
            clearInterval(timerInterval);
            expireSession();
          }
        }, 1000);
      }

      function expireSession() {
        sessionExpired = true;
        stopPolling();
        show('qr-expired-overlay');
        hide('polling-status');
        const timerEl = $('session-timer');
        if (timerEl) timerEl.textContent = '00:00';
      }

      function resetTimer() {
        clearInterval(timerInterval);
        sessionExpired = false;
        const timerEl = $('session-timer');
        const ring    = $('timer-ring');
        if (timerEl) { timerEl.textContent = '15:00'; timerEl.classList.remove('text-red-500'); timerEl.classList.add('text-gray-700'); }
        if (ring)    { ring.style.strokeDashoffset = '0'; ring.style.stroke = '#111827'; }
      }

      // ── Cashfree: create order ────────────────────────────────────────
      async function createCashfreeOrder(customerDetails) {
        const res = await fetch(`${apiUrl}/api/payments/cashfree/create-order`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: totalAmount, currency: 'INR', customer: customerDetails, cartItems, shippingCharge }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.message || 'Failed to create payment order');
        }
        return res.json(); // { orderId, paymentSessionId, upiQrUrl, upiVpa, upiName }
      }

      // ── Poll for payment status every 5s ─────────────────────────────
      function startPolling() {
        stopPolling();
        pollInterval = setInterval(pollPaymentStatus, 5000);
      }

      function stopPolling() {
        if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
      }

      async function pollPaymentStatus() {
        if (sessionExpired || !cashfreeOrderId) return;
        try {
          const res = await fetch(`${apiUrl}/api/payments/cashfree/status/${cashfreeOrderId}`);
          if (!res.ok) return;
          const data = await res.json();
          // Normalise — Cashfree returns uppercase e.g. "PAID"
          const status = (data.status || data.order_status || '').toUpperCase().trim();
          console.log('[Payment] Poll status:', status);

          if (status === 'PAID') {
            stopPolling();
            clearInterval(timerInterval);
            await onPaymentSuccess();
          } else if (status === 'FAILED' || status === 'EXPIRED' || status === 'CANCELLED') {
            stopPolling();
            clearInterval(timerInterval);
            onPaymentFailed();
          }
          // ACTIVE = still waiting, keep polling
        } catch (e) {
          console.warn('[Payment] Poll error (retrying):', e.message);
        }
      }

      // ── Payment success ───────────────────────────────────────────────
      async function onPaymentSuccess() {
        // Stop all activity immediately
        stopPolling();
        clearInterval(timerInterval);

        // Hide everything in the UPI section, show only success banner
        console.log('[Payment] SUCCESS — hiding QR, showing banner');
        hide('polling-status');
        hide('qr-wrapper');
        hide('qr-expired-overlay');
        hide('payment-failed-banner');
        // Hide the timer row
        const timerRow = document.querySelector('#upi-payment-section .flex.items-center.justify-between');
        if (timerRow) timerRow.style.display = 'none';
        show('payment-success-banner');

        try {
          const res = await fetch(`${apiUrl}/api/payments/cashfree/confirm-order`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              cashfreeOrderId,
              customer:      currentCustomer,
              cartItems,
              subtotal,
              shippingCharge,
              totalAmount,
            }),
          });
          if (!res.ok) throw new Error('Save failed');
          const { orderNumber } = await res.json();

          // Clear cart
          localStorage.removeItem('cart');
          const badge = document.getElementById('cart-badge');
          if (badge) badge.textContent = '0';

          setTimeout(() => { window.location.href = `/order/${orderNumber}`; }, 1800);
        } catch {
          // Payment confirmed but save failed — redirect with CF order ID as fallback
          setTimeout(() => { window.location.href = `/order/pending?cf_order_id=${cashfreeOrderId}`; }, 1800);
        }
      }

      // ── Payment failed ────────────────────────────────────────────────
      function onPaymentFailed() {
        hide('polling-status');
        hide('qr-wrapper');
        show('payment-failed-banner');
      }

      // ── Form validation ───────────────────────────────────────────────
      function getCustomerDetails() {
        const name    = $('customer-name')?.value?.trim();
        const phone   = $('customer-phone')?.value?.trim();
        const email   = $('customer-email')?.value?.trim();
        const address = $('delivery-address')?.value?.trim();
        const city    = $('city')?.value?.trim();
        const state   = $('state')?.value?.trim();
        const pincode = $('pincode')?.value?.trim();
        if (!name || !phone || !email || !address || !city || !state || !pincode) {
          showError('Please fill in all required fields.'); return null;
        }
        if (!/^[0-9]{10}$/.test(phone)) { showError('Enter a valid 10-digit phone number.'); return null; }
        if (!/^[0-9]{6}$/.test(pincode)) { showError('Enter a valid 6-digit pincode.'); return null; }
        return { name, phone, email, address, city, state, pincode };
      }

      // ── Pay now ───────────────────────────────────────────────────────
      async function initiatePayment() {
        const customer = getCustomerDetails();
        if (!customer) return;
        currentCustomer = customer;

        setLoading('pay-now-btn', true);
        resetTimer();
        hide('payment-failed-banner');

        try {
          const result     = await createCashfreeOrder(customer);
          cashfreeOrderId  = result.orderId;
          paymentSessionId = result.paymentSessionId;

          // Use Cashfree QR if backend returns it, else build UPI string QR
          const qrImg = $('upi-qr-image');
          if (result.upiQrUrl && qrImg) {
            qrImg.src = result.upiQrUrl;
          } else if (result.upiVpa) {
            upiDetails.vpa  = result.upiVpa;
            upiDetails.name = result.upiName || upiDetails.name;
            const upiStr = `upi://pay?pa=${encodeURIComponent(upiDetails.vpa)}&pn=${encodeURIComponent(upiDetails.name)}&am=${totalAmount}&cu=INR&tn=${encodeURIComponent('Order #' + cashfreeOrderId)}`;
            if (qrImg) qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=192x192&data=${encodeURIComponent(upiStr)}`;
          }

          show('qr-wrapper');
          show('polling-status');
          hide('pay-now-btn');
          show('upi-payment-section');
          startSessionTimer();
          startPolling();

        } catch (err) {
          showError(err.message || 'Could not initiate payment. Try again.');
        } finally {
          setLoading('pay-now-btn', false, `
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.243m-4.243 0L9 9m3 3l-3 3" />
            </svg>
            Pay with UPI`);
        }
      }

      $('pay-now-btn')?.addEventListener('click', initiatePayment);

      // Retry after failure
      $('retry-payment-btn')?.addEventListener('click', () => {
        hide('payment-failed-banner');
        hide('upi-payment-section');
        show('pay-now-btn');
        cashfreeOrderId = '';
        paymentSessionId = '';
      });

      // Refresh after QR expiry
      $('refresh-qr-btn')?.addEventListener('click', () => {
        hide('qr-expired-overlay');
        hide('upi-payment-section');
        show('pay-now-btn');
        cashfreeOrderId = '';
        paymentSessionId = '';
        show('polling-status');
        resetTimer();
      });

      // ── Init ──────────────────────────────────────────────────────────
      await loadRemoteData();
      loadCart();
      $('pincode')?.addEventListener('blur', checkPincode);
    });
  </script>
</Layout>