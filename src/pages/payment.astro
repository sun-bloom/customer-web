      function checkPincode() {
        const pincode = $("pincode")?.value?.trim();
        const statusEl = $("pincode-status");
        if (!pincode || pincode.length !== 6 || !statusEl) return;
        const regions =
          deliverySettings.regions?.length > 0
            ? deliverySettings.regions
            : FALLBACK_REGIONS;
        const num = parseInt(pincode);
        let found = false;
        for (const region of regions) {
          if (!region.isEnabled) continue;
          if (
            num >= parseInt(region.pincodeStart) &&
            num <= parseInt(region.pincodeEnd)
          ) {
            shippingCharge = region.deliveryCharge;
            statusEl.innerHTML = `<span class="text-green-600 text-xs">✓ ${region.regionName} — Delivery in ${region.estimatedDays} day${region.estimatedDays > 1 ? "s" : ""} · ₹${region.deliveryCharge} shipping</span>`;
            found = true;
            break;
          }
        }
        if (!found)
          statusEl.innerHTML = `<span class="text-red-600 text-xs">✗ Delivery not available for this pincode</span>`;
        updateTotals();
      }

      //MARK: ── Cashfree: create order ────────────────────────────────────────
      async function createCashfreeOrder(customerDetails) {
        const res = await fetch(
          `${apiUrl}/api/payments/cashfree/create-order`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              amount: totalAmount,
              currency: "INR",
              customer: customerDetails,
              cartItems,
              shippingCharge,
              subtotal,
              totalAmount,
            }),
          },
        );
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          // Attach stockErrors so caller can display them properly
          const error = new Error(
            err.message || "Failed to create payment order",
          );
          if (err.stockErrors) error.stockErrors = err.stockErrors;
          throw error;
        }
        return res.json(); // { orderId, orderNumber, paymentSessionId, upiVpa, upiName }
      }
 
      // ── Form validation ───────────────────────────────────────────────
      function getCustomerDetails() {
        const name = $("customer-name")?.value?.trim();
        const phone = $("customer-phone")?.value?.trim();
        const email = $("customer-email")?.value?.trim();
        const address = $("delivery-address")?.value?.trim();
        const city = $("city")?.value?.trim();
        const state = $("state")?.value?.trim();
        const pincode = $("pincode")?.value?.trim();
        if (
          !name ||
          !phone ||
          !email ||
          !address ||
          !city ||
          !state ||
          !pincode
        ) {
          showError("Please fill in all required fields.");
          return null;
        }
        if (!/^[0-9]{10}$/.test(phone)) {
          showError("Enter a valid 10-digit phone number.");
          return null;
        }
        if (!/^[0-9]{6}$/.test(pincode)) {
          showError("Enter a valid 6-digit pincode.");
          return null;
        }
        return { name, phone, email, address, city, state, pincode };
      }
      // ── Pay now ───────────────────────────────────────────────────────
      async function initiatePayment() {
        const customer = getCustomerDetails();
        if (!customer) return;
        currentCustomer = customer;

        setLoading("pay-now-btn", true);
        hide("payment-failed-banner");

        try {
          const result = await createCashfreeOrder(customer);
          cashfreeOrderId = result.orderId;
          orderNumber = result.orderNumber;
          paymentSessionId = result.paymentSessionId;
          orderExpiryTime = new Date(Date.now() + SESSION_DURATION * 1000);
        } catch (err) {
          // Handle stock errors — show each unavailable item clearly
          if (err.stockErrors) {
            const msgs = err.stockErrors
              .map((e) => `${e.productName}: ${e.reason}`)
              .join("\n");
            showStockErrors(err.stockErrors);
          } else {
            showError(err.message || "Could not initiate payment. Try again.");
          }
        } finally {
          setLoading(
            "pay-now-btn",
            false,
            `
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.243m-4.243 0L9 9m3 3l-3 3" />
            </svg>
            Pay with UPI`,
          );
        }
      }

      // $("pay-now-btn")?.addEventListener("click", initiatePayment);
      $("pay-now-btn")?.addEventListener("click", startCheckout);

      // ── Init ──────────────────────────────────────────────────────────
      await loadRemoteData();
      console.log("Payment page loaded", new Date().toISOString());
      loadCart();
      $("pincode")?.addEventListener("blur", checkPincode);

      function loadCashfreeSdk() {
        return new Promise((resolve, reject) => {
          if (window.Cashfree) {
            return resolve(window.Cashfree);
          }
          const script = document.createElement("script");
          script.src = "https://sdk.cashfree.com/js/v3/cashfree.js";
          script.onload = () => resolve(window.Cashfree);
          script.onerror = () => reject("Failed to load Cashfree SDK");
          document.head.appendChild(script);
        });
      }

      async function startCheckout() {
        try {
          // 1. Call your backend API to create order and get a paymentSessionId
          await initiatePayment();
          // 2. Wait for SDK to be ready
          const Cashfree = await loadCashfreeSdk();
          // 3. Initialize checkout
          const cashfree = Cashfree({
            mode:"sandbox"
          });

          cashfree.checkout({
            paymentSessionId,
            redirectTarget: "_modal"
          })
          .then(async function(result) {
            //  console.log("Checkout Result:", result);
             window.location.replace(`/order/pending?cf_order_id=${cashfreeOrderId}`)
          })
          .catch(function(error) {
             console.error("Payment Error:", error);
          });
        } catch (err) {
          console.error("Error starting checkout:", err);
        }
      }
    });
