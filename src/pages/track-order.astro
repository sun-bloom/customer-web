---
import Layout from '../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:4040';
---

<Layout title="Track Order - Fashion Store">
  <main class="min-h-screen bg-gray-50 py-8 md:py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold font-heading tracking-tight text-gray-900 uppercase">
          Track Order
        </h1>
        <p class="mt-2 text-gray-500">
          Track your order status and delivery
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-sm p-6 md:p-8">
        <form id="track-order-form" class="space-y-6">
          <div id="phone-section">
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
              Phone Number *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              pattern="[0-9]{10}"
              maxlength="10"
              placeholder="9876543210"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            />
            <p class="text-xs text-gray-500 mt-1">Enter 10 digit mobile number</p>
          </div>

          <div>
            <label for="orderNumber" class="block text-sm font-medium text-gray-700 mb-1">
              Order Number *
            </label>
            <input
              type="text"
              id="orderNumber"
              name="orderNumber"
              required
              placeholder="ORD-1234567890"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            />
            <p class="text-xs text-gray-500 mt-1">Enter the order number from your confirmation</p>
          </div>

          <button
            type="submit"
            id="track-btn"
            class="w-full bg-amber-500 text-white py-3 px-6 rounded-md font-medium hover:bg-amber-600 transition-colors"
          >
            Track Order
          </button>
        </form>

        <div id="loading-state" class="hidden py-12 text-center">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
          <p class="mt-2 text-sm text-gray-600">Looking up your order...</p>
        </div>

        <div id="error-state" class="hidden py-6">
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p id="error-message" class="text-sm text-red-700"></p>
            </div>
          </div>
        </div>

        <div id="order-result" class="hidden mt-6">
          <div class="border rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-4 py-3 border-b">
              <div class="flex justify-between items-center">
                <div>
                  <p class="text-sm text-gray-500">Order Number</p>
                  <p id="result-order-number" class="font-semibold text-gray-900"></p>
                </div>
                <div id="result-status" class="px-3 py-1 rounded-full text-xs font-medium"></div>
              </div>
            </div>

            <div class="p-4 space-y-4">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-sm text-gray-500 mb-1">Order Date</p>
                  <p id="result-date" class="font-medium"></p>
                </div>
                <div>
                  <p class="text-sm text-gray-500 mb-1">Total Amount</p>
                  <p id="result-total" class="font-medium text-lg"></p>
                </div>
              </div>

              <div>
                <p class="text-sm text-gray-500 mb-1">Payment Status</p>
                <p id="result-payment-status" class="font-medium"></p>
              </div>

              <div id="result-tracking-section" class="pt-4 border-t">
                <p class="text-sm text-gray-500 mb-3">Shipping Status</p>
                
                <div id="tracking-available" class="hidden">
                  <div class="bg-blue-50 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                      </svg>
                      <p id="result-carrier" class="font-medium text-blue-900"></p>
                    </div>
                    <p id="result-tracking-number" class="text-sm text-blue-700 font-mono mb-3"></p>
                    <a
                      id="result-tracking-link"
                      href="#"
                      target="_blank"
                      class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors"
                    >
                      Track Package
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>

                <div id="tracking-pending" class="hidden">
                  <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-lg p-6 text-center">
                    <div class="relative inline-block mb-4">
                      <div class="absolute inset-0 bg-orange-200 rounded-full animate-ping opacity-20"></div>
                      <div class="relative bg-white rounded-full p-4 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-orange-500 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                      </div>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-2">Preparing Your Order</h3>
                    <p class="text-sm text-gray-600 mb-3">
                      We're carefully packing your items with love. Tracking details will be available once your order ships.
                    </p>
                    <div class="flex items-center justify-center gap-2 text-xs text-amber-500">
                      <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
                      </span>
                      Packing in progress
                    </div>
                  </div>
                </div>

                <div id="tracking-confirmed" class="hidden">
                  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg p-6 text-center">
                    <div class="relative inline-block mb-4">
                      <div class="absolute inset-0 bg-blue-200 rounded-full animate-pulse opacity-20"></div>
                      <div class="relative bg-white rounded-full p-4 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-2">Order Confirmed</h3>
                    <p class="text-sm text-gray-600 mb-3">
                      Your order has been confirmed and will be shipped soon. You'll receive tracking information shortly.
                    </p>
                    <div class="flex items-center justify-center gap-2 text-xs text-blue-600">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Awaiting shipment
                    </div>
                  </div>
                </div>

                <div id="tracking-shipped" class="hidden">
                  <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-lg p-6 text-center">
                    <div class="relative inline-block mb-4">
                      <div class="absolute inset-0 bg-purple-200 rounded-full animate-ping opacity-20"></div>
                      <div class="relative bg-white rounded-full p-4 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-purple-500 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                        </svg>
                      </div>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-2">On the Way!</h3>
                    <p class="text-sm text-gray-600 mb-3">
                      Your order has been shipped and is on its way to you!
                    </p>
                  </div>
                </div>

                <div id="tracking-delivered" class="hidden">
                  <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg p-6 text-center">
                    <div class="relative inline-block mb-4">
                      <div class="bg-white rounded-full p-4 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-2">Delivered!</h3>
                    <p class="text-sm text-gray-600">
                      Your order has been delivered. We hope you love your purchase!
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-gray-50 px-4 py-3 border-t">
              <a
                id="view-full-order-link"
                href="#"
                class="block w-full text-center bg-amber-500 text-white py-2 px-4 rounded-md font-medium hover:bg-amber-600 transition-colors"
              >
                View Full Order Details
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <p class="text-sm text-gray-500">
          Don't have your order number? 
          <a href="/orders" class="text-gray-900 font-medium hover:underline">
            View all your orders
          </a>
        </p>
      </div>
    </div>
  </main>

  <script type="module" define:vars={{ apiUrl }}>
    const API_BASE_URL = apiUrl;
    const form = document.getElementById('track-order-form');
    const trackBtn = document.getElementById('track-btn');
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMessage = document.getElementById('error-message');
    const orderResult = document.getElementById('order-result');
    const phoneInput = document.getElementById('phone');

    const statusColors = {
      'PENDING': 'bg-yellow-100 text-yellow-800',
      'CONFIRMED': 'bg-blue-100 text-blue-800',
      'SHIPPED': 'bg-purple-100 text-purple-800',
      'DELIVERED': 'bg-green-100 text-green-800',
      'CANCELLED': 'bg-red-100 text-red-800'
    };

    const statusLabels = {
      'PENDING': 'Pending',
      'CONFIRMED': 'Confirmed',
      'SHIPPED': 'Shipped',
      'DELIVERED': 'Delivered',
      'CANCELLED': 'Cancelled'
    };

    function checkLocalStorageForPhone() {
      try {
        const lastOrder = sessionStorage.getItem('lastOrder');
        if (lastOrder) {
          const order = JSON.parse(lastOrder);
          if (order.customerPhone) {
            phoneInput.value = order.customerPhone;
            return order.customerPhone;
          }
        }
        
        const orders = localStorage.getItem('orders');
        if (orders) {
          const ordersList = JSON.parse(orders);
          if (ordersList.length > 0 && ordersList[0].customerPhone) {
            phoneInput.value = ordersList[0].customerPhone;
            return ordersList[0].customerPhone;
          }
        }
      } catch (e) {
        console.error('Error reading from storage:', e);
      }
      return null;
    }

    checkLocalStorageForPhone();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const phone = phoneInput.value.trim();
      const orderNumber = document.getElementById('orderNumber').value.trim();

      if (!phone || !orderNumber) {
        showError('Please enter both phone number and order number');
        return;
      }

      if (phone.length !== 10 || !/^\d{10}$/.test(phone)) {
        showError('Please enter a valid 10 digit phone number');
        return;
      }

      setLoading(true);
      hideError();
      hideResult();

      try {
        const response = await fetch(
          `${API_BASE_URL}/api/orders/track?phone=${encodeURIComponent(phone)}&orderNumber=${encodeURIComponent(orderNumber)}`
        );

        if (!response.ok) {
          if (response.status === 404) {
            throw new Error('Order not found. Please check your phone number and order number.');
          }
          throw new Error('Failed to track order. Please try again.');
        }

        const order = await response.json();
        showOrderResult(order, phone);
      } catch (error) {
        showError(error.message);
      } finally {
        setLoading(false);
      }
    });

    function setLoading(loading) {
      if (loading) {
        form.classList.add('hidden');
        loadingState.classList.remove('hidden');
      } else {
        form.classList.remove('hidden');
        loadingState.classList.add('hidden');
      }
    }

    function showError(message) {
      errorMessage.textContent = message;
      errorState.classList.remove('hidden');
    }

    function hideError() {
      errorState.classList.add('hidden');
    }

    function hideResult() {
      orderResult.classList.add('hidden');
    }

    function hideAllTrackingStates() {
      document.getElementById('tracking-available').classList.add('hidden');
      document.getElementById('tracking-pending').classList.add('hidden');
      document.getElementById('tracking-confirmed').classList.add('hidden');
      document.getElementById('tracking-shipped').classList.add('hidden');
      document.getElementById('tracking-delivered').classList.add('hidden');
    }

    function showOrderResult(order, phone) {
      document.getElementById('result-order-number').textContent = order.orderNumber;
      document.getElementById('result-date').textContent = new Date(order.createdAt).toLocaleDateString('en-IN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      });
      document.getElementById('result-total').textContent = new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 0
      }).format(order.totalAmount);

      const statusElement = document.getElementById('result-status');
      const normalizedStatus = order.status.toUpperCase();
      statusElement.textContent = statusLabels[normalizedStatus] || order.status;
      statusElement.className = `px-3 py-1 rounded-full text-xs font-medium ${statusColors[normalizedStatus] || 'bg-gray-100 text-gray-800'}`;

      const paymentStatusElement = document.getElementById('result-payment-status');
      const paymentStatus = order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1);
      paymentStatusElement.textContent = paymentStatus;
      paymentStatusElement.className = `font-medium ${order.paymentStatus === 'paid' ? 'text-green-600' : 'text-yellow-600'}`;

      hideAllTrackingStates();
      const trackingSection = document.getElementById('result-tracking-section');
      trackingSection.classList.remove('hidden');

      if (order.trackingNumber) {
        document.getElementById('tracking-available').classList.remove('hidden');
        document.getElementById('result-carrier').textContent = order.trackingCarrier || 'Courier';
        document.getElementById('result-tracking-number').textContent = order.trackingNumber;
        const trackingLink = document.getElementById('result-tracking-link');
        if (order.trackingUrl) {
          trackingLink.href = order.trackingUrl;
          trackingLink.classList.remove('hidden');
        } else {
          trackingLink.classList.add('hidden');
        }
      } else {
        switch (normalizedStatus) {
          case 'PENDING':
            document.getElementById('tracking-pending').classList.remove('hidden');
            break;
          case 'CONFIRMED':
            document.getElementById('tracking-confirmed').classList.remove('hidden');
            break;
          case 'SHIPPED':
            document.getElementById('tracking-shipped').classList.remove('hidden');
            break;
          case 'DELIVERED':
            document.getElementById('tracking-delivered').classList.remove('hidden');
            break;
          default:
            document.getElementById('tracking-pending').classList.remove('hidden');
        }
      }

      const viewLink = document.getElementById('view-full-order-link');
      viewLink.href = `/order/${order.orderNumber}?phone=${encodeURIComponent(phone)}`;

      orderResult.classList.remove('hidden');
    }
  </script>
</Layout>
