---
import Layout from '../layouts/Layout.astro';
const lastUpdated = 'June 2025';
const site = {
  name: 'Sunbloom Adorn',
  email: 'sunbloomadorn@gmail.com',
  phone: '+91 99522 53464',
};
---

<Layout title="Refund Policy">
  <main class="min-h-screen bg-gray-50 py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold font-heading tracking-tight text-gray-900 uppercase">
          Refund Policy
        </h1>
        <p class="mt-3 text-gray-400 text-sm">Last updated: {lastUpdated}</p>
      </div>

      <!-- Key notice banner -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl px-6 py-5 mb-8 flex items-start gap-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-amber-500 shrink-0 mt-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.94949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
        <div>
          <p class="font-semibold text-amber-800 text-sm">Important Notice</p>
          <p class="text-amber-700 text-sm mt-1 leading-relaxed">
            Refunds at {site.name} are applicable <strong>only for products that arrive damaged or defective</strong>. We do not accept returns or issue refunds for change of mind, incorrect size selection, or any reason other than damage during transit. All refunds are processed to the original payment method — <strong>no cash refunds</strong>.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 md:p-10 space-y-8">

        <!-- Section 1 -->
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="bg-amber-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold shrink-0">1</span>
            Eligibility for Refund
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">
            A refund will be considered only if:
          </p>
          <ul class="text-gray-600 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>The product you received is <strong>physically damaged</strong> (broken, cracked, bent, or otherwise compromised).</li>
            <li>The product is <strong>defective</strong> and not in the condition as described at the time of purchase.</li>
            <li>You report the issue within <strong>7 days</strong> of delivery.</li>
            <li>The product is returned in its original packaging with all tags and accessories intact.</li>
          </ul>
          <p class="text-gray-500 text-sm mt-3 bg-gray-50 rounded-lg px-4 py-3 border border-gray-100">
            Refunds are <strong>not</strong> applicable for: change of mind, colour variation due to screen settings, minor design variations within acceptable manufacturing tolerances, or damage caused by misuse after delivery.
          </p>
        </div>

        <!-- Section 2 -->
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="bg-amber-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold shrink-0">2</span>
            How to Report a Damaged Product
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">
            To initiate a refund request for a damaged product, please follow these steps:
          </p>
          <ol class="text-gray-600 text-sm leading-relaxed list-none space-y-4 pl-0">
            <li class="flex items-start gap-3">
              <span class="bg-stone-100 text-stone-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
              <span><strong>Take clear photos / video</strong> of the damaged product immediately upon unpacking. Include the packaging and the product together if possible.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-stone-100 text-stone-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
              <span><strong>Contact us within 7 days</strong> of receiving your order via WhatsApp or email (details below). Late reports will not be eligible for refund.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-stone-100 text-stone-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
              <span>Include your <strong>order ID, name, phone number</strong>, and attach the photos/video in your message.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="bg-stone-100 text-stone-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">4</span>
              <span>Our team will review your request and get back to you within <strong>1–2 business days</strong>.</span>
            </li>
          </ol>
        </div>

        <!-- Section 3 -->
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="bg-amber-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold shrink-0">3</span>
            Refund Process & Timelines
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">
            <strong>Refunds are processed within 7 business days</strong> of claim approval. Here is the detailed timeline:
          </p>
          <ul class="text-gray-600 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>Once your damaged product claim is approved, we initiate the refund within <strong>2 business days</strong>.</li>
            <li>Refund is processed to your original payment method. <strong>No cash refunds will be issued under any circumstances.</strong></li>
            <li>Refund reflection in your account: Typically <strong>5–7 business days</strong> for UPI/cards, <strong>7–10 business days</strong> for net banking, depending on your bank or payment provider.</li>
            <li>In some cases, we may offer a <strong>replacement</strong> instead of a refund, at our discretion.</li>
            <li>Shipping charges are non-refundable unless the error was on our part.</li>
          </ul>
        </div>

        <!-- Section 4 - Chargeback & Payment Gateway Alignment -->
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="bg-amber-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold shrink-0">4</span>
            Chargebacks & Payment Gateway Compliance
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">
            We process payments through Cashfree Payments. The following rules apply in alignment with Cashfree's chargeback policies:
          </p>
          <ul class="text-gray-600 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>Customers must first attempt resolution directly with us before filing a chargeback with their bank.</li>
            <li>Chargebacks filed without prior communication may be contested with supporting evidence (delivery proof, communication logs, product photos).</li>
            <li>If a chargeback is filed, the refund process via our policy will be paused pending the chargeback outcome.</li>
            <li>We comply with RBI guidelines and Cashfree's merchant terms regarding dispute resolution timelines.</li>
          </ul>
        </div>

        <!-- Section 5 -->
        <div>
          <h2 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <span class="bg-amber-500 text-white rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold shrink-0">5</span>
            Non-Refundable Situations
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">We are unable to process refunds in the following situations:</p>
          <ul class="text-gray-600 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>The return request is made after 7 days of delivery.</li>
            <li>The product shows signs of use, wear, or damage after delivery.</li>
            <li>The product was damaged due to mishandling by the customer.</li>
            <li>The customer changed their mind or ordered the wrong item.</li>
            <li>Minor colour differences due to screen calibration or photography lighting.</li>
            <li>Cash refund requests — all refunds are processed to the original payment method only.</li>
          </ul>
        </div>

        <!-- Cross-link to Terms & Conditions -->
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-6">
          <h2 class="text-base font-bold text-gray-900 mb-2">Related Policies</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">
            This Refund Policy should be read in conjunction with our <a href="/terms" class="text-amber-500 hover:text-amber-600 underline font-medium">Terms &amp; Conditions</a> and <a href="/privacy" class="text-amber-500 hover:text-amber-600 underline font-medium">Privacy Policy</a> for a complete understanding of your rights and obligations.
          </p>
        </div>

        <!-- Contact -->
        <div class="bg-stone-50 rounded-xl p-6 border border-stone-100">
          <h2 class="text-base font-bold text-gray-900 mb-3">Need to reach us?</h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            If you have a damaged product to report or have questions about our refund policy, please contact us:
          </p>
          <div class="space-y-2 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-amber-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <a href={`mailto:${site.email}`} class="text-amber-500 hover:text-amber-600 transition-colors">{site.email}</a>
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-amber-500 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-amber-500 hover:text-amber-600 transition-colors">{site.phone}</a>
            </div>
          </div>
          <div class="mt-4">
            <a href="/contact" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">
              Contact Us
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>
</Layout>
