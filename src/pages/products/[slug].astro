---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
let product = null;
let fetchError = false;

try {
  const res = await fetch(`${apiUrl}/api/products/slug/${encodeURIComponent(slug ?? '')}`);
  if (res.ok) {
    const data = await res.json();
    if (data && data.isActive) product = data;
  }
} catch (e) {
  fetchError = true;
  console.error('[slug].astro fetch error:', e);
}

const variants = product?.variants ?? [];
const colors   = [...new Set(variants.map((v: any) => v.color))];
const patterns = [...new Set(variants.map((v: any) => v.pattern))];
const prices   = variants.map((v: any) => product.basePrice + v.additionalPrice);
const minPrice = prices.length ? Math.min(...prices) : 0;
const maxPrice = prices.length ? Math.max(...prices) : 0;
const priceDisplay = !prices.length ? '₹0' : minPrice === maxPrice ? `₹${minPrice}` : `₹${minPrice} - ₹${maxPrice}`;
const categoryLabel = !product ? '' :
  typeof product.category === 'string' ? product.category : (product.category?.name ?? '');
const firstVariant = variants.find((v: any) => v.isAvailable) ?? variants[0] ?? null;
const pageTitle = product ? `${product.name} - Fashion Store` : 'Product Not Found';
---

<Layout title={pageTitle}>
  <style>
    input[type='number']::-webkit-outer-spin-button,
    input[type='number']::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type='number'] { -moz-appearance: textfield; }

    /* Skeleton shimmer */
    @keyframes shimmer {
      0%   { background-position: -800px 0; }
      100% { background-position: 800px 0; }
    }
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 800px 100%;
      animation: shimmer 1.4s infinite linear;
      border-radius: 4px;
    }
  </style>

  {!product && !fetchError ? (
    <!-- ── Skeleton Loading State ─────────────────────────────────── -->
    <div class="container mx-auto px-4 py-8">
      <!-- Breadcrumb skeleton -->
      <div class="mb-6 flex items-center gap-2">
        <div class="skeleton h-4 w-10"></div>
        <div class="skeleton h-4 w-3"></div>
        <div class="skeleton h-4 w-16"></div>
        <div class="skeleton h-4 w-3"></div>
        <div class="skeleton h-4 w-32"></div>
      </div>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Image skeleton -->
        <div class="w-full lg:w-1/2">
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="skeleton w-full h-96"></div>
            <div class="flex p-4 space-x-2">
              {[1,2,3,4].map(() => <div class="skeleton w-20 h-20 rounded flex-shrink-0"></div>)}
            </div>
          </div>
        </div>

        <!-- Details skeleton -->
        <div class="w-full lg:w-1/2">
          <div class="bg-white rounded-lg shadow-md p-6 space-y-5">
            <div class="skeleton h-8 w-3/4"></div>
            <div class="skeleton h-8 w-24"></div>
            <div class="skeleton h-4 w-20"></div>
            <div class="space-y-2">
              <div class="skeleton h-4 w-full"></div>
              <div class="skeleton h-4 w-5/6"></div>
              <div class="skeleton h-4 w-4/6"></div>
            </div>
            <div>
              <div class="skeleton h-4 w-16 mb-2"></div>
              <div class="flex gap-2">
                {[1,2,3].map(() => <div class="skeleton h-10 w-20 rounded-md"></div>)}
              </div>
            </div>
            <div>
              <div class="skeleton h-4 w-16 mb-2"></div>
              <div class="flex gap-2">
                {[1,2].map(() => <div class="skeleton h-10 w-24 rounded-md"></div>)}
              </div>
            </div>
            <div class="skeleton h-12 w-full rounded-md"></div>
          </div>
        </div>
      </div>
    </div>
  ) : product ? (
    <!-- ── Product Found ─────────────────────────────────────────── -->
    <div class="container mx-auto px-4 py-8">
      <nav class="mb-6 text-sm">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="text-gray-600 hover:text-black">Home</a></li>
          <li><span class="text-gray-500">/</span></li>
          <li><a href="/products" class="text-gray-600 hover:text-black">Products</a></li>
          <li><span class="text-gray-500">/</span></li>
          <li class="text-gray-700 font-medium">{product.name}</li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Left: Images -->
        <div class="w-full lg:w-1/2">
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="relative">
              <img id="main-image" src={product.images?.[0] ?? ''} alt={product.name} class="w-full h-96 object-cover" />
            </div>
            <div class="flex p-4 space-x-2 overflow-x-auto">
              {(product.images ?? []).map((image: string, index: number) => (
                <img
                  src={image}
                  alt={`${product.name} view ${index + 1}`}
                  class="thumbnail w-20 h-20 object-cover rounded cursor-pointer border-2 border-gray-200 hover:border-gray-900 transition-colors"
                  data-index={index}
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
          </div>
        </div>

        <!-- Right: Details -->
        <div class="w-full lg:w-1/2">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold mb-4">{product.name}</h1>

            <div class="mb-4">
              <span id="price-display" class="text-2xl font-bold text-gray-900">{priceDisplay}</span>
            </div>

            <div class="mb-6">
              <p id="stock-status" class={firstVariant?.stock > 0 ? 'text-gray-600 font-medium' : 'text-gray-500 font-medium'}>
                {firstVariant?.stock > 0 ? 'In Stock' : 'Out of Stock'}
              </p>
              <p id="stock-count" class="text-sm text-gray-600">
                {firstVariant?.stock > 0 ? `${firstVariant.stock} units available` : ''}
              </p>
            </div>

            <div class="mb-6">
              <p class="text-gray-700">{product.description}</p>
            </div>

            <!-- Variants -->
            <div class="mb-6">
              <div class="mb-4">
                <h3 class="font-medium mb-2">Color</h3>
                <div id="color-options" class="flex flex-wrap gap-2">
                  {colors.map((color, idx) => (
                    <button type="button" data-color={color}
                      class={`color-option py-2 px-4 rounded-md border-2 transition-colors ${idx === 0 ? 'selected border-gray-900 bg-gray-50' : 'border-gray-300'}`}>
                      {color}
                    </button>
                  ))}
                </div>
              </div>
              <div class="mb-4">
                <h3 class="font-medium mb-2">Pattern</h3>
                <div id="pattern-options" class="flex flex-wrap gap-2">
                  {patterns.map((pattern, idx) => (
                    <button type="button" data-pattern={pattern}
                      class={`pattern-option py-2 px-4 rounded-md border-2 transition-colors ${idx === 0 ? 'selected border-gray-900 bg-gray-50' : 'border-gray-300'}`}>
                      {pattern}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- Quantity -->
            <div class="mb-6">
              <h3 class="font-medium mb-2">Quantity</h3>
              <div class="flex items-center space-x-3">
                <button id="decrease-qty" class="w-10 h-10 rounded-md border-2 border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                  </svg>
                </button>
                <input id="quantity-input" type="number" min="1" max={Math.min(10, firstVariant?.stock ?? 1)} value="1"
                  class="w-20 text-center border-2 border-gray-300 rounded-md py-2 font-medium focus:outline-none focus:border-gray-900" />
                <button id="increase-qty" class="w-10 h-10 rounded-md border-2 border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-4 mb-6">
              <button id="add-to-cart-btn"
                disabled={!firstVariant || firstVariant.stock <= 0}
                class={`flex-1 py-3 px-6 rounded-md font-medium transition-colors ${firstVariant?.stock > 0 ? 'bg-gray-900 text-white hover:bg-black' : 'bg-gray-300 text-gray-500 cursor-not-allowed'}`}>
                Add to Cart
              </button>
              <a href="/products" class="flex-1 bg-gray-200 text-gray-800 py-3 px-6 rounded-md font-medium hover:bg-gray-300 transition-colors text-center">
                Continue Shopping
              </a>
            </div>

            <div id="cart-message" class="hidden mb-4 p-3 bg-green-100 text-green-800 rounded-md">
              Item added to cart!
            </div>

            <!-- Product Meta -->
            <div class="border-t pt-6">
              <h3 class="font-medium mb-3">Product Details</h3>
              <ul class="space-y-2 text-sm text-gray-600">
                <li>SKU: <span>{variants[0]?.sku ?? '-'}</span></li>
                <li>Category: <span>{categoryLabel.replace('_', ' ')}</span></li>
                <li>Material: Cotton blend</li>
                <li>Care: Machine wash, gentle cycle</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <!-- ── Product Not Found ──────────────────────────────────────── -->
    <div class="container mx-auto px-4 py-8">
      <div class="bg-white border border-gray-200 p-8 text-center">
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Product not found</h2>
        <p class="text-gray-600 mb-6">This product may be unavailable or removed.</p>
        <a href="/products" class="inline-flex items-center justify-center bg-gray-900 text-white px-6 py-3 text-sm hover:bg-black transition-colors">
          Browse Products
        </a>
      </div>
    </div>
  )}

  {product && (
    <script define:vars={{ product, variants, colors, patterns, firstVariant }}>
      let selectedVariant = firstVariant;

      document.querySelectorAll('.thumbnail').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          document.getElementById('main-image').src = product.images[parseInt(thumb.dataset.index)];
          document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('ring-2', 'ring-gray-900'));
          thumb.classList.add('ring-2', 'ring-gray-900');
        });
      });

      function updatePrice() {
        if (!selectedVariant) return;
        document.getElementById('price-display').textContent = `₹${product.basePrice + selectedVariant.additionalPrice}`;
      }

      function updateStock() {
        const statusEl = document.getElementById('stock-status');
        const countEl  = document.getElementById('stock-count');
        const qtyInput = document.getElementById('quantity-input');
        const btn      = document.getElementById('add-to-cart-btn');
        const inStock  = selectedVariant?.stock > 0;

        statusEl.textContent = inStock ? 'In Stock' : 'Out of Stock';
        statusEl.className   = inStock ? 'text-gray-600 font-medium' : 'text-gray-500 font-medium';
        countEl.textContent  = inStock ? `${selectedVariant.stock} units available` : '';

        const max = inStock ? Math.max(1, Math.min(10, selectedVariant.stock)) : 1;
        qtyInput.max = String(max);
        if (parseInt(qtyInput.value) > max) qtyInput.value = String(max);

        btn.disabled = !inStock;
        btn.className = `flex-1 py-3 px-6 rounded-md font-medium transition-colors ${inStock ? 'bg-gray-900 text-white hover:bg-black' : 'bg-gray-300 text-gray-500 cursor-not-allowed'}`;
      }

      function setActive(buttons, active) {
        buttons.forEach(b => { b.classList.remove('selected','border-gray-900','bg-gray-50'); b.classList.add('border-gray-300'); });
        if (active) { active.classList.add('selected','border-gray-900','bg-gray-50'); active.classList.remove('border-gray-300'); }
      }

      function pickVariant(color, pattern) {
        const v = variants.find(v => v.color === color && v.pattern === pattern && v.isAvailable);
        if (v) { selectedVariant = v; updatePrice(); updateStock(); }
      }

      const colorBtns   = document.querySelectorAll('.color-option');
      const patternBtns = document.querySelectorAll('.pattern-option');

      colorBtns.forEach(btn => btn.addEventListener('click', () => {
        const pattern = document.querySelector('.pattern-option.selected')?.dataset.pattern ?? patterns[0];
        setActive(colorBtns, btn);
        pickVariant(btn.dataset.color, pattern);
      }));

      patternBtns.forEach(btn => btn.addEventListener('click', () => {
        const color = document.querySelector('.color-option.selected')?.dataset.color ?? colors[0];
        setActive(patternBtns, btn);
        pickVariant(color, btn.dataset.pattern);
      }));

      const qtyInput = document.getElementById('quantity-input');
      document.getElementById('decrease-qty').addEventListener('click', () => {
        const v = parseInt(qtyInput.value) || 1;
        if (v > 1) qtyInput.value = v - 1;
      });
      document.getElementById('increase-qty').addEventListener('click', () => {
        const v = parseInt(qtyInput.value) || 1;
        const max = parseInt(qtyInput.max) || 10;
        if (v < max) qtyInput.value = v + 1;
      });

      document.getElementById('add-to-cart-btn').addEventListener('click', () => {
        if (!selectedVariant) return alert('This product is currently unavailable.');
        const quantity   = parseInt(qtyInput.value) || 1;
        const maxAllowed = Math.max(0, Math.min(10, selectedVariant.stock ?? 0));
        if (maxAllowed <= 0) return alert('This variant is out of stock.');
        if (quantity > maxAllowed) {
          alert(`Only ${maxAllowed} units available.`);
          qtyInput.value = String(maxAllowed);
          return;
        }

        const cartItem = {
          productId:    product.id,
          variantId:    selectedVariant.id,
          productName:  product.name,
          productSlug:  product.slug,
          productImage: product.images?.[0] ?? '',
          color:        selectedVariant.color,
          pattern:      selectedVariant.pattern,
          quantity,
          unitPrice:    product.basePrice + selectedVariant.additionalPrice,
          totalPrice:   (product.basePrice + selectedVariant.additionalPrice) * quantity,
        };

        let cart = JSON.parse(localStorage.getItem('cart') || '[]');
        const idx = cart.findIndex(i => i.productId === cartItem.productId && i.variantId === cartItem.variantId);

        if (idx >= 0) {
          const next = cart[idx].quantity + quantity;
          if (next > maxAllowed) return alert(`Only ${maxAllowed} units available. Cart already has ${cart[idx].quantity}.`);
          cart[idx].quantity   = next;
          cart[idx].totalPrice = next * cart[idx].unitPrice;
        } else {
          cart.push(cartItem);
        }

        localStorage.setItem('cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cart:updated',    { detail: { cart, timestamp: Date.now() } }));
        window.dispatchEvent(new CustomEvent('cart:item-added', { detail: { item: cartItem, timestamp: Date.now() } }));

        const msg = document.getElementById('cart-message');
        msg.classList.remove('hidden');
        setTimeout(() => msg.classList.add('hidden'), 3000);
      });
    </script>
  )}
</Layout>