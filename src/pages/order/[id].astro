---
import Layout from '../../layouts/Layout.astro';
import settingsData from '../../data/settings.json';
import ordersData from '../../data/orders.json';

// Generate static paths for all orders (in a real app, this would be dynamic)
export async function getStaticPaths() {
  // For now, we'll generate a placeholder path
  return [
    { params: { id: '1001' } }
  ];
}

// Get the order ID from the URL
const { id } = Astro.params;

// Get site settings
const { site, upi } = settingsData;

// In a real application, we would fetch the order from a database
// For now, we'll use placeholder data
const order = {
  id: 'order-123456',
  orderNumber: id,
  customerName: 'John Doe',
  customerPhone: '9876543210',
  customerEmail: 'john.doe@example.com',
  deliveryAddress: '123 Main Street, Apt 4B',
  city: 'Mumbai',
  state: 'Maharashtra',
  pincode: '400001',
  items: [
    {
      productId: 'crop-top-001',
      variantId: 'crop-top-001-red',
      productName: 'Floral Print Crop Top',
      color: 'Red',
      pattern: 'Floral',
      quantity: 2,
      unitPrice: 899,
      totalPrice: 1798
    },
    {
      productId: 'anarkali-001',
      variantId: 'anarkali-001-blue',
      productName: 'Royal Blue Anarkali Suit',
      color: 'Royal Blue',
      pattern: 'Embroidered',
      quantity: 1,
      unitPrice: 2499,
      totalPrice: 2499
    }
  ],
  subtotal: 4297,
  shippingCharge: 0,
  totalAmount: 4297,
  paymentMethod: 'upi',
  paymentStatus: 'pending',
  paymentScreenshot: '',
  upiTransactionId: '',
  paidAt: null,
  orderStatus: 'pending',
  trackingCarrier: '',
  trackingNumber: '',
  trackingUrl: '',
  shippedAt: null,
  deliveredAt: null,
  notes: '',
  createdAt: '2026-01-26T00:00:00Z',
  updatedAt: '2026-01-26T00:00:00Z'
};
---

<Layout title={`Order ${order.orderNumber} - Fashion Store`}>
  <script is:inline>
    // Load order details from sessionStorage
    let order = null;
    
    try {
      const orderData = sessionStorage.getItem('lastOrder');
      if (orderData) {
        order = JSON.parse(orderData);
        
        // Update order details on the page
        document.getElementById('order-number').textContent = order.orderNumber;
        document.getElementById('order-date').textContent = new Date(order.createdAt).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
        
        document.getElementById('customer-name').textContent = order.customerName;
        document.getElementById('customer-phone').textContent = order.customerPhone;
        document.getElementById('customer-email').textContent = order.customerEmail;
        document.getElementById('delivery-address').textContent = order.deliveryAddress;
        document.getElementById('customer-city').textContent = order.city;
        document.getElementById('customer-state').textContent = order.state;
        document.getElementById('customer-pincode').textContent = order.pincode;
        
        // Update order items
        const orderItemsContainer = document.getElementById('order-items');
        orderItemsContainer.innerHTML = '';
        
        order.items.forEach(item => {
          const itemElement = document.createElement('div');
          itemElement.className = 'flex items-center space-x-4 py-4 border-b';
          itemElement.innerHTML = `
            <div class="w-16 h-16 flex-shrink-0 bg-gray-200 rounded-md flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-medium text-gray-900">${item.productName}</h3>
              <p class="text-xs text-gray-500">${item.color} / ${item.pattern} × ${item.quantity}</p>
              <p class="text-sm font-medium text-gray-900">₹${item.unitPrice} each</p>
            </div>
            
            <div class="text-right">
              <p class="text-base font-medium text-gray-900">₹${item.totalPrice}</p>
            </div>
          `;
          
          orderItemsContainer.appendChild(itemElement);
        });
        
        // Update order totals
        document.getElementById('order-subtotal').textContent = `₹${order.subtotal}`;
        document.getElementById('order-shipping').textContent = order.shippingCharge === 0 ? 'FREE' : `₹${order.shippingCharge}`;
        document.getElementById('order-total').textContent = `₹${order.totalAmount}`;
        
        // Update payment status
        const statusElement = document.getElementById('payment-status');
        if (order.paymentStatus === 'pending') {
          statusElement.innerHTML = `
            <span class="flex items-center text-yellow-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Pending Payment
            </span>
          `;
        } else if (order.paymentStatus === 'paid') {
          statusElement.innerHTML = `
            <span class="flex items-center text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Payment Confirmed
            </span>
          `;
        }
        
        // Update order status
        const orderStatusElement = document.getElementById('order-status');
        if (order.orderStatus === 'pending') {
          orderStatusElement.textContent = 'Order Placed';
          orderStatusElement.className = 'px-3 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800';
        } else if (order.orderStatus === 'confirmed') {
          orderStatusElement.textContent = 'Order Confirmed';
          orderStatusElement.className = 'px-3 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800';
        } else if (order.orderStatus === 'shipped') {
          orderStatusElement.textContent = 'Shipped';
          orderStatusElement.className = 'px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800';
        } else if (order.orderStatus === 'delivered') {
          orderStatusElement.textContent = 'Delivered';
          orderStatusElement.className = 'px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800';
        }
      }
    } catch (error) {
      console.error('Error loading order details:', error);
    }
  </script>
  
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
        <div class="flex items-center mb-4">
          <div class="flex-shrink-0 bg-green-100 rounded-full p-2 mr-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Order Placed Successfully!</h1>
            <p class="text-gray-600">Thank you for your purchase. We've received your order and will process it shortly.</p>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row sm:justify-between text-sm">
          <div>
            <span class="font-medium text-gray-700">Order Number:</span>
            <span id="order-number" class="ml-2 font-bold text-gray-900"></span>
          </div>
          <div>
            <span class="font-medium text-gray-700">Order Date:</span>
            <span id="order-date" class="ml-2"></span>
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Order Details -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Customer Information -->
          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-lg font-semibold mb-4">Customer Information</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-gray-600">Name</p>
                <p id="customer-name" class="font-medium"></p>
              </div>
              
              <div>
                <p class="text-sm text-gray-600">Phone</p>
                <p id="customer-phone" class="font-medium"></p>
              </div>
              
              <div>
                <p class="text-sm text-gray-600">Email</p>
                <p id="customer-email" class="font-medium"></p>
              </div>
              
              <div>
                <p class="text-sm text-gray-600">Pincode</p>
                <p id="customer-pincode" class="font-medium"></p>
              </div>
            </div>
            
            <div class="mt-4">
              <p class="text-sm text-gray-600">Delivery Address</p>
              <p id="delivery-address" class="font-medium"></p>
              <p id="customer-city" class="font-medium"></p>
              <p id="customer-state" class="font-medium"></p>
            </div>
          </div>
          
          <!-- Order Items -->
          <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-lg font-semibold mb-4">Order Items</h2>
            
            <div id="order-items" class="divide-y divide-gray-200">
              <!-- Order items will be inserted here by JavaScript -->
            </div>
          </div>
        </div>
        
        <!-- Order Summary -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-md p-6 sticky top-6">
            <h2 class="text-lg font-semibold mb-4">Order Summary</h2>
            
            <div class="space-y-3 pb-4 border-b">
              <div class="flex justify-between">
                <span class="text-gray-600">Subtotal</span>
                <span id="order-subtotal" class="font-medium">₹0</span>
              </div>
              
              <div class="flex justify-between">
                <span class="text-gray-600">Shipping</span>
                <span id="order-shipping" class="font-medium">₹0</span>
              </div>
            </div>
            
            <div class="pt-4">
              <div class="flex justify-between items-center mb-6">
                <span class="text-lg font-semibold">Total</span>
                <span id="order-total" class="text-xl font-bold text-gray-900">₹0</span>
              </div>
              
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-600">Payment Status</span>
                  <span id="payment-status" class="text-sm"></span>
                </div>
                
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-600">Order Status</span>
                  <span id="order-status" class="px-3 py-1 text-xs font-medium rounded-full"></span>
                </div>
                
                <div class="pt-4 border-t">
                  <p class="text-sm text-gray-600 mb-4">You'll receive order updates on your email and phone.</p>
                  
                  <a href="/" class="w-full block bg-gray-900 text-white py-3 px-6 rounded-md font-medium hover:bg-black transition-colors text-center">
                    Continue Shopping
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>