---
import Layout from '../../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:4040';
---

<Layout title="My Orders - Fashion Store">
  <main class="min-h-screen bg-gray-50 py-8 md:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold font-heading tracking-tight text-gray-900 uppercase">
          My Orders
        </h1>
        <p class="mt-2 text-gray-500">Track and manage your orders</p>
      </div>

      <div id="phone-lookup-section" class="bg-white rounded-lg shadow-sm p-6 md:p-8 mb-8">
        <h2 class="text-lg font-semibold mb-4">Look Up Your Orders</h2>
        <p class="text-sm text-gray-500 mb-4">Enter your phone number to see all orders placed with this number.</p>
        
        <form id="lookup-form" class="flex gap-4">
          <div class="flex-1">
            <input
              type="tel"
              id="lookup-phone"
              maxlength="10"
              pattern="[0-9]{10}"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
            />
          </div>
          <button
            type="submit"
            id="lookup-btn"
            class="bg-amber-500 text-white px-6 py-2 rounded-md font-medium hover:bg-amber-600 transition-colors"
          >
            View Orders
          </button>
        </form>
      </div>

      <div id="loading-state" class="hidden py-12 text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
        <p class="mt-2 text-sm text-gray-600">Loading your orders...</p>
      </div>

      <div id="error-state" class="hidden mb-8">
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p id="error-message" class="text-sm text-red-700"></p>
          </div>
        </div>
      </div>

      <div id="orders-list" class="hidden space-y-6">
        <div class="flex justify-between items-center">
          <h2 class="text-lg font-semibold">Your Orders</h2>
          <button id="change-phone-btn" class="text-sm text-gray-600 hover:text-gray-900 underline">
            Use different phone number
          </button>
        </div>
        <div id="orders-container" class="space-y-6">
        </div>
      </div>

      <div id="empty-state" class="hidden bg-white rounded-lg shadow-sm p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-16 w-16 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h2 class="text-xl font-semibold text-gray-900 mb-2">No orders found</h2>
        <p class="text-gray-500 mb-6">We couldn't find any orders for this phone number.</p>
        <a 
          href="/products"
          class="inline-block bg-amber-500 text-white font-medium px-8 py-3 hover:bg-amber-600 transition-colors tracking-widest uppercase text-sm"
        >
          Start Shopping
        </a>
      </div>
    </div>
  </main>

  <script type="module" define:vars={{ apiUrl }}>
    const API_URL = apiUrl;
    const lookupSection = document.getElementById('phone-lookup-section');
    const lookupForm = document.getElementById('lookup-form');
    const lookupBtn = document.getElementById('lookup-btn');
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMessage = document.getElementById('error-message');
    const ordersList = document.getElementById('orders-list');
    const ordersContainer = document.getElementById('orders-container');
    const emptyState = document.getElementById('empty-state');
    const changePhoneBtn = document.getElementById('change-phone-btn');

    const statusColors = {
      'pending': 'bg-yellow-100 text-yellow-800',
      'confirmed': 'bg-blue-100 text-blue-800',
      'shipped': 'bg-purple-100 text-purple-800',
      'delivered': 'bg-green-100 text-green-800',
      'cancelled': 'bg-red-100 text-red-800'
    };

    const statusLabels = {
      'pending': 'Pending',
      'confirmed': 'Confirmed',
      'shipped': 'Shipped',
      'delivered': 'Delivered',
      'cancelled': 'Cancelled'
    };

    lookupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const phone = document.getElementById('lookup-phone').value.trim();
      
      if (!phone || phone.length !== 10 || !/^\d{10}$/.test(phone)) {
        showError('Please enter a valid 10 digit phone number');
        return;
      }

      setLoading(true);
      hideError();
      hideOrders();
      hideEmpty();

      try {
        const response = await fetch(`${API_URL}/api/orders/by-phone?phone=${encodeURIComponent(phone)}`);
        
        if (!response.ok) {
          throw new Error('Failed to fetch orders');
        }

        const data = await response.json();
        
        if (data.orders && data.orders.length > 0) {
          showOrders(data.orders, phone);
        } else {
          showEmpty();
        }
      } catch (error) {
        showError('Failed to load orders. Please try again.');
        console.error(error);
      } finally {
        setLoading(false);
      }
    });

    changePhoneBtn.addEventListener('click', () => {
      lookupSection.classList.remove('hidden');
      hideOrders();
      hideEmpty();
      document.getElementById('lookup-phone').value = '';
    });

    function setLoading(loading) {
      if (loading) {
        lookupBtn.disabled = true;
        lookupBtn.textContent = 'Loading...';
        loadingState.classList.remove('hidden');
      } else {
        lookupBtn.disabled = false;
        lookupBtn.textContent = 'View Orders';
        loadingState.classList.add('hidden');
      }
    }

    function showError(message) {
      errorMessage.textContent = message;
      errorState.classList.remove('hidden');
    }

    function hideError() {
      errorState.classList.add('hidden');
    }

    function showOrders(orders, phone) {
      lookupSection.classList.add('hidden');
      ordersContainer.innerHTML = orders.map(order => `
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div>
                <p class="text-sm text-gray-500">Order Number</p>
                <p class="font-semibold text-gray-900">#${order.orderNumber}</p>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <p class="text-sm text-gray-500">Placed On</p>
                  <p class="font-medium text-gray-900">${new Date(order.createdAt).toLocaleDateString('en-IN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-medium capitalize ${statusColors[order.orderStatus] || 'bg-gray-100 text-gray-800'}">
                  ${statusLabels[order.orderStatus] || order.orderStatus}
                </span>
              </div>
            </div>
          </div>

          <div class="p-6">
            <div class="space-y-4">
              ${order.items.map(item => `
                <div class="flex items-center gap-4">
                  <div class="w-20 h-20 bg-gray-100 rounded-md overflow-hidden flex-shrink-0">
                    ${item.image
                      ? `<img src="${item.image}" alt="${item.productName || 'Product'}" class="w-full h-full object-cover" />`
                      : `<div class="w-full h-full flex items-center justify-center"><span class="text-gray-400 text-xs">No Image</span></div>`
                    }
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-medium text-gray-900 truncate">${item.productName || 'Product'}</h4>
                    <p class="text-sm text-gray-500">${item.color || ''}${item.color && item.pattern ? ' / ' : ''}${item.pattern || ''}</p>
                    <p class="text-sm text-gray-500">Qty: ${item.quantity}</p>
                  </div>
                  <p class="font-medium text-gray-900">${new Intl.NumberFormat('en-IN', {
                    style: 'currency',
                    currency: 'INR',
                    minimumFractionDigits: 0
                  }).format(item.totalPrice ?? (item.unitPrice * item.quantity))}</p>
                </div>
              `).join('')}
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="text-sm text-gray-500">
                  <span class="font-medium text-gray-900">${order.items.length}</span> item${order.items.length !== 1 ? 's' : ''} • 
                  Total: <span class="font-semibold text-gray-900">${new Intl.NumberFormat('en-IN', {
                    style: 'currency',
                    currency: 'INR',
                    minimumFractionDigits: 0
                  }).format(order.totalAmount)}</span>
                </div>
                <a 
                  href="/order/${order.orderNumber}?phone=${encodeURIComponent(phone)}"
                  class="text-sm font-medium text-black hover:text-gray-600 transition-colors uppercase tracking-wide"
                >
                  View Details →
                </a>
              </div>
            </div>

            ${order.trackingNumber ? `
              <div class="mt-4 pt-4 border-t border-gray-100">
                <div class="bg-blue-50 rounded-lg p-3">
                  <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                    </svg>
                    <p class="text-sm text-blue-900 font-medium">${order.trackingCarrier || 'Courier'}</p>
                  </div>
                  <p class="text-sm text-blue-700 font-mono mt-1">${order.trackingNumber}</p>
                  ${order.trackingUrl ? `
                    <a href="${order.trackingUrl}" target="_blank" class="inline-flex items-center gap-1 text-sm text-blue-600 hover:underline mt-2">
                      Track Package
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  ` : ''}
                </div>
              </div>
            ` : `
              <div class="mt-4 pt-4 border-t border-gray-100">
                <div class="bg-gray-50 rounded-lg p-3 flex items-center gap-3">
                  <div class="relative">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gray-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-gray-500"></span>
                    </span>
                  </div>
                  <p class="text-sm text-gray-600">
                    ${order.orderStatus === 'confirmed' ? 'Confirmed - Will ship soon' :
                      order.orderStatus === 'shipped' ? 'Shipped - On the way' :
                      order.orderStatus === 'delivered' ? 'Delivered' :
                      'Preparing your order'}
                  </p>
                </div>
              </div>
            `}
          </div>
        </div>
      `).join('');
      
      ordersList.classList.remove('hidden');
    }

    function hideOrders() {
      ordersList.classList.add('hidden');
    }

    function showEmpty() {
      lookupSection.classList.add('hidden');
      emptyState.classList.remove('hidden');
    }

    function hideEmpty() {
      emptyState.classList.add('hidden');
    }
  </script>
</Layout>