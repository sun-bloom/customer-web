---
const { apiUrl } = Astro.props;
---

  <script is:inline define:vars={{ apiUrl }}>
    // Load order details - try sessionStorage first, then API
    let order = null;
    let siteSettings = null;
    
    async function loadSettings() {
      try {
        const response = await fetch(`${apiUrl}/api/public/settings`);
        if (response.ok) {
          siteSettings = await response.json();
        }
      } catch (e) {
        console.log('Could not load settings');
      }
    }
    
    function showLoading() {
      document.getElementById('order-loading')?.classList.remove('hidden');
      document.getElementById('order-not-found')?.classList.add('hidden');
      document.getElementById('order-content')?.classList.add('hidden');
    }

    function hideLoading() {
      document.getElementById('order-loading')?.classList.add('hidden');
    }

    function showContent() {
      document.getElementById('order-content')?.classList.remove('hidden');
      document.getElementById('order-not-found')?.classList.add('hidden');
    }

    async function loadOrder() {
      try {
        const orderNumber = window.location.pathname.split('/').pop();

        if (!orderNumber) {
          hideLoading();
          document.getElementById('order-not-found')?.classList.remove('hidden');
          return;
        }

        // Fetch order directly by order number (public endpoint — no phone needed)
        // console.log("order id", orderNumber);
        const response = await fetch(`${apiUrl}/api/orders/by-number/${encodeURIComponent(orderNumber)}`);

        if (response.ok) {
          order = await response.json();
          displayOrder(order);
          hideLoading();
          showContent();
          return;
        }

        // Order not found
        hideLoading();
        document.getElementById('order-not-found')?.classList.remove('hidden');
        document.getElementById('order-content')?.classList.add('hidden');
      } catch (error) {
        console.error('Error loading order:', error);
        hideLoading();
        document.getElementById('order-not-found')?.classList.remove('hidden');
        document.getElementById('order-content')?.classList.add('hidden');
      }
    }
    
    function displayOrder(order) {
      if (!order) return;
        // Update order details on the page
        document.getElementById('order-number').textContent = order.orderNumber;
        document.getElementById('order-date').textContent = new Date(order.createdAt).toLocaleDateString('en-IN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
        
        document.getElementById('customer-name').textContent = order.customerName;
        document.getElementById('customer-phone').textContent = order.customerPhone;
        document.getElementById('customer-email').textContent = order.customerEmail;
        document.getElementById('delivery-address').textContent = order.deliveryAddress;
        document.getElementById('customer-city').textContent = order.city;
        document.getElementById('customer-state').textContent = order.state;
        document.getElementById('customer-pincode').textContent = order.pincode;
        
        // Update order items
        const orderItemsContainer = document.getElementById('order-items');
        orderItemsContainer.innerHTML = '';
        
        order.items.forEach(item => {
          const price = item.unitPrice || item.price || 0;
          const total = item.totalPrice || (price * item.quantity);
          const name  = item.productName || item.name || 'Product';
          const image = item.image || '';
          const variantLabel = item.variant || [item.color, item.pattern].filter(Boolean).join(' / ');

          const itemElement = document.createElement('div');
          itemElement.className = 'flex items-center gap-4 py-4 border-b border-gray-100';
          itemElement.innerHTML = `
            <div class="w-20 h-20 rounded-md bg-gray-100 overflow-hidden flex-shrink-0">
              ${image
                ? `<img src="${image}" alt="${name}" class="w-full h-full object-cover" />`
                : `<div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">No Image</div>`
              }
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-medium text-gray-900">${name}</h3>
              <p class="text-sm text-gray-500">${variantLabel} × ${item.quantity}</p>
              <p class="text-sm font-medium text-gray-900">₹${price.toLocaleString('en-IN')} each</p>
            </div>
            <div class="text-right">
              <p class="font-medium text-gray-900">₹${total.toLocaleString('en-IN')}</p>
            </div>
          `;
          orderItemsContainer.appendChild(itemElement);
        });
        
        // Update order totals
        const subtotal = order.subtotal || order.items.reduce((sum, item) => sum + ((item.price || item.unitPrice) * item.quantity), 0);
        const shipping = order.shippingCharge || order.shipping || 0;
        const total = order.total || order.totalAmount || subtotal + shipping;
        
        document.getElementById('order-subtotal').textContent = subtotal === 0 ? 'FREE' : '₹' + subtotal.toLocaleString('en-IN');
        document.getElementById('order-shipping').textContent = shipping === 0 ? 'FREE' : '₹' + shipping.toLocaleString('en-IN');
        document.getElementById('order-total').textContent = '₹' + total.toLocaleString('en-IN');
        
        // Update payment status
        const paymentStatus = order.payment?.status || order.paymentStatus || 'pending';
        const statusElement = document.getElementById('payment-status');
        if (paymentStatus === 'paid') {
          statusElement.innerHTML = `
            <span class="flex items-center text-green-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Paid
            </span>
          `;
        } else {
          statusElement.innerHTML = `
            <span class="flex items-center text-yellow-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Pending
            </span>
          `;
        }
        
        // Update order status
        const orderStatus = order.status || order.orderStatus || 'processing';
        const orderStatusElement = document.getElementById('order-status');
        const statusColors = {
          'delivered': 'bg-green-100 text-green-800',
          'shipped': 'bg-blue-100 text-blue-800',
          'processing': 'bg-yellow-100 text-yellow-800',
          'cancelled': 'bg-red-100 text-red-800',
          'confirmed': 'bg-green-100 text-green-800',
          'pending': 'bg-gray-100 text-gray-800'
        };
        orderStatusElement.textContent = orderStatus.charAt(0).toUpperCase() + orderStatus.slice(1);
        orderStatusElement.className = 'px-3 py-1 text-xs font-medium rounded-full ' + (statusColors[orderStatus.toLowerCase()] || 'bg-gray-100 text-gray-800');

        // Show Screenshot if exists
        const screenshotContainer = document.getElementById('screenshot-container');
        const screenshotImg = document.getElementById('screenshot-img');
        const screenshot = order.payment?.screenshot || order.paymentScreenshot;
        if (screenshot) {
          screenshotImg.src = screenshot;
          screenshotContainer.classList.remove('hidden');
        }

        // Update WhatsApp Link
        const whatsappBtn = document.getElementById('whatsapp-btn');
        if (whatsappBtn && siteSettings?.whatsappNumber) {
          const message = `Hello, I've placed an order!\n\nOrder #: ${order.orderNumber}\nTotal: ₹${total.toLocaleString('en-IN')}\nName: ${order.customerName}\n\nPlease confirm my order.`;
          whatsappBtn.href = `https://wa.me/${siteSettings.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
        } else if (whatsappBtn) {
          // Hide WhatsApp button if no number configured
          whatsappBtn.style.display = 'none';
        }

        // Show tracking information based on status
        const trackingContainer = document.getElementById('tracking-container');
        const trackingAvailable = document.getElementById('tracking-available');
        const trackingPending = document.getElementById('tracking-pending');
        const trackingConfirmed = document.getElementById('tracking-confirmed');
        const trackingShipped = document.getElementById('tracking-shipped');
        const trackingDelivered = document.getElementById('tracking-delivered');
        const trackingCarrier = document.getElementById('tracking-carrier');
        const trackingNumber = document.getElementById('tracking-number');
        const trackingLink = document.getElementById('tracking-link');
        
        if (trackingContainer) {
          trackingContainer.classList.remove('hidden');
          
          // Hide all tracking states first
          trackingAvailable?.classList.add('hidden');
          trackingPending?.classList.add('hidden');
          trackingConfirmed?.classList.add('hidden');
          trackingShipped?.classList.add('hidden');
          trackingDelivered?.classList.add('hidden');
          
          const normalizedStatus = (order.status || order.orderStatus || 'pending').toUpperCase();
          
          if (order.trackingNumber) {
            // Show tracking details
            trackingAvailable?.classList.remove('hidden');
            if (trackingCarrier) trackingCarrier.textContent = order.trackingCarrier || 'Courier';
            if (trackingNumber) trackingNumber.textContent = order.trackingNumber;
            if (trackingLink && order.trackingUrl) {
              trackingLink.href = order.trackingUrl;
              trackingLink.classList.remove('hidden');
            }
          } else {
            // Show status-based animation
            switch (normalizedStatus) {
              case 'PENDING':
                trackingPending?.classList.remove('hidden');
                break;
              case 'CONFIRMED':
                trackingConfirmed?.classList.remove('hidden');
                break;
              case 'SHIPPED':
                trackingShipped?.classList.remove('hidden');
                break;
              case 'DELIVERED':
                trackingDelivered?.classList.remove('hidden');
                break;
              default:
                trackingPending?.classList.remove('hidden');
            }
          }
        }
    }

    // Load order when DOM is ready
    async function init() {
      showLoading();
      await loadSettings();
      await loadOrder();
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>

  <main class="min-h-screen bg-gray-50 py-8 md:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Loading State -->
      <div id="order-loading" class="bg-white rounded-lg shadow-sm p-12 text-center">
        <div class="mx-auto h-12 w-12 border-4 border-gray-200 border-t-gray-900 rounded-full animate-spin mb-4"></div>
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Loading your order</h2>
        <p class="text-gray-500">Please wait a moment.</p>
      </div>

      <!-- Order Not Found Message -->
      <div id="order-not-found" class="hidden bg-white rounded-lg shadow-sm p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-16 w-16 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h2 class="text-xl font-semibold text-gray-900 mb-2">Order Not Found</h2>
        <p class="text-gray-500 mb-6">We couldn't find this order. Please check the order number and try again.</p>
        <a href="/orders" class="inline-block bg-gray-900 text-white py-2 px-6 rounded-md font-medium hover:bg-black transition-colors">
          View My Orders
        </a>
      </div>

      <!-- Order Content -->
      <div id="order-content">
        <!-- Success Message -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <div class="flex items-center mb-4">
              <div class="flex-shrink-0 bg-green-100 rounded-full p-2 mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h1 class="text-2xl font-bold text-gray-900">Order Placed Successfully!</h1>
                <p class="text-gray-600">Thank you for your purchase. We've received your order.</p>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row sm:justify-between text-sm">
              <div>
                <span class="font-medium text-gray-700">Order Number:</span>
                <span id="order-number" class="ml-2 font-bold text-gray-900"></span>
              </div>
              <div>
                <span class="font-medium text-gray-700">Order Date:</span>
                <span id="order-date" class="ml-2"></span>
              </div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Order Details -->
            <div class="lg:col-span-2 space-y-6">
              <!-- Customer Information -->
              <div class="bg-white rounded-lg shadow-sm p-6">
                <h2 class="text-lg font-semibold mb-4">Customer Information</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <p class="text-sm text-gray-500">Name</p>
                    <p id="customer-name" class="font-medium text-gray-900"></p>
                  </div>
                  
                  <div>
                    <p class="text-sm text-gray-500">Phone</p>
                    <p id="customer-phone" class="font-medium text-gray-900"></p>
                  </div>
                  
                  <div>
                    <p class="text-sm text-gray-500">Email</p>
                    <p id="customer-email" class="font-medium text-gray-900"></p>
                  </div>
                  
                  <div>
                    <p class="text-sm text-gray-500">Pincode</p>
                    <p id="customer-pincode" class="font-medium text-gray-900"></p>
                  </div>
                </div>
                
                <div class="mt-4 pt-4 border-t border-gray-100">
                  <p class="text-sm text-gray-500">Delivery Address</p>
                  <p id="delivery-address" class="font-medium text-gray-900"></p>
                  <p id="customer-city" class="font-medium text-gray-900"></p>
                  <p id="customer-state" class="font-medium text-gray-900"></p>
                </div>

                <!-- Payment Screenshot -->
                <div id="screenshot-container" class="hidden mt-6 pt-4 border-t border-gray-100">
                  <p class="text-sm text-gray-500 mb-2">Payment Screenshot</p>
                  <div class="w-32 h-auto border rounded overflow-hidden shadow-sm">
                    <img id="screenshot-img" src="" alt="Payment Screenshot" class="w-full" />
                  </div>
                </div>
              </div>
              
              <!-- Order Items -->
              <div class="bg-white rounded-lg shadow-sm p-6">
                <h2 class="text-lg font-semibold mb-4">Order Items</h2>
                
                <div id="order-items" class="divide-y divide-gray-100">
                  <!-- Order items will be inserted here by JavaScript -->
                </div>
              </div>
            </div>
            
            <!-- Order Summary -->
            <div class="lg:col-span-1">
              <div class="bg-white rounded-lg shadow-sm p-6 sticky top-6">
                <h2 class="text-lg font-semibold mb-4">Order Summary</h2>
                
                <div class="space-y-3 pb-4 border-b border-gray-100">
                  <div class="flex justify-between">
                    <span class="text-gray-600">Subtotal</span>
                    <span id="order-subtotal" class="font-medium">₹0</span>
                  </div>
                  
                  <div class="flex justify-between">
                    <span class="text-gray-600">Shipping</span>
                    <span id="order-shipping" class="font-medium">₹0</span>
                  </div>
                </div>
                
                <div class="pt-4">
                  <div class="flex justify-between items-center mb-6">
                    <span class="text-lg font-semibold">Total</span>
                    <span id="order-total" class="text-xl font-bold text-gray-900">₹0</span>
                  </div>
                  
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-600">Payment Status</span>
                      <span id="payment-status" class="text-sm"></span>
                    </div>
                    
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-600">Order Status</span>
                      <span id="order-status" class="px-3 py-1 text-xs font-medium rounded-full"></span>
                    </div>
                     
                    <div id="tracking-container" class="hidden pt-4 border-t border-gray-100">
                      <p class="text-sm text-gray-600 mb-2">Shipping Status</p>
                      
                      <div id="tracking-available" class="hidden">
                        <div class="bg-blue-50 rounded-lg p-3">
                          <p class="font-medium text-blue-900" id="tracking-carrier"></p>
                          <p class="text-sm text-blue-700 font-mono mt-1" id="tracking-number"></p>
                          <a id="tracking-link" href="#" target="_blank" class="hidden inline-flex items-center gap-1 text-sm text-blue-600 hover:underline mt-2">
                            Track Package
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                          </a>
                        </div>
                      </div>

                      <div id="tracking-pending" class="hidden">
                        <div class="bg-gradient-to-br from-orange-50 to-amber-50 rounded-lg p-4 text-center">
                          <div class="relative inline-block mb-3">
                            <div class="absolute inset-0 bg-orange-200 rounded-full animate-ping opacity-20"></div>
                            <div class="relative bg-white rounded-full p-3 shadow-sm">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-orange-500 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                              </svg>
                            </div>
                          </div>
                          <h4 class="font-medium text-gray-900 mb-1">Preparing Your Order</h4>
                          <p class="text-xs text-gray-600">We're packing your items with love!</p>
                          <div class="flex items-center justify-center gap-2 mt-2 text-xs text-orange-600">
                            <span class="relative flex h-2 w-2">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
                            </span>
                            Packing in progress
                          </div>
                        </div>
                      </div>

                      <div id="tracking-confirmed" class="hidden">
                        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-lg p-4 text-center">
                          <div class="relative inline-block mb-3">
                            <div class="absolute inset-0 bg-blue-200 rounded-full animate-pulse opacity-20"></div>
                            <div class="relative bg-white rounded-full p-3 shadow-sm">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                              </svg>
                            </div>
                          </div>
                          <h4 class="font-medium text-gray-900 mb-1">Order Confirmed</h4>
                          <p class="text-xs text-gray-600">Will be shipped soon!</p>
                          <div class="flex items-center justify-center gap-1 mt-2 text-xs text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Awaiting shipment
                          </div>
                        </div>
                      </div>

                      <div id="tracking-shipped" class="hidden">
                        <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-lg p-4 text-center">
                          <div class="relative inline-block mb-3">
                            <div class="absolute inset-0 bg-purple-200 rounded-full animate-ping opacity-20"></div>
                            <div class="relative bg-white rounded-full p-3 shadow-sm">
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-purple-500 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                              </svg>
                            </div>
                          </div>
                          <h4 class="font-medium text-gray-900 mb-1">On the Way!</h4>
                          <p class="text-xs text-gray-600">Your order is on its way!</p>
                        </div>
                      </div>

                      <div id="tracking-delivered" class="hidden">
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg p-4 text-center">
                          <div class="bg-white rounded-full p-3 shadow-sm inline-block mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                            </svg>
                          </div>
                          <h4 class="font-medium text-gray-900 mb-1">Delivered!</h4>
                          <p class="text-xs text-gray-600">Hope you love it!</p>
                        </div>
                      </div>
                    </div>
                    
                    <div class="pt-4 border-t border-gray-100">
                      <p class="text-sm text-gray-500 mb-4">You'll receive order updates on your email and phone.</p>
                      
                      <a id="whatsapp-btn" href="#" target="_blank" class="w-full flex items-center justify-center bg-green-600 text-white py-3 px-6 rounded-md font-medium hover:bg-green-700 transition-colors text-center mb-2">
                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        Confirm on WhatsApp
                      </a>

                      <a href="/" class="w-full block bg-black text-white py-3 px-6 rounded-md font-medium hover:bg-gray-800 transition-colors text-center">
                        Continue Shopping
                      </a>
                    </div>
                  </div>
