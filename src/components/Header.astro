---
import CartBadge from './CartBadge.tsx';
import CartDrawer from './CartDrawer.tsx';
import settingsData from '../data/settings.json';
import productsData from '../data/products.json';

const { site } = settingsData;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Shop All', href: '/products' },
  { name: 'New Arrivals', href: '/products?sort=new' },
];

// Get categories for dropdown
const categories = productsData.categories;
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold font-heading tracking-tight text-gray-900 group">
          Your<span class="text-gray-400 group-hover:text-gray-900 transition-colors">Shop</span>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm uppercase tracking-wide"
          >
            {link.name}
          </a>
        ))}
        
        <!-- Categories Dropdown -->
        <div class="relative group">
          <button class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm uppercase tracking-wide flex items-center">
            Categories
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute z-10 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right">
            <div class="py-1">
              {categories.map((category) => (
                <a
                  href={`/products?category=${category.slug}`}
                  class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors"
                >
                  {category.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>

      <!-- Right Actions -->
      <div class="flex items-center space-x-4">
        <!-- Search Icon (Optional) -->
        <button class="p-2 text-gray-500 hover:text-gray-900 transition-colors">
            <span class="sr-only">Search</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
        </button>

        <!-- Cart Island -->
        <CartBadge client:load />
        
        <!-- Cart Drawer -->
        <CartDrawer client:load />

        <!-- Mobile Menu Button -->
        <button type="button" class="md:hidden p-2 text-gray-500" aria-label="Menu">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
        </button>
      </div>
    </div>
  </div>
</header>
