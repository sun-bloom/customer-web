---
const { apiUrl } = Astro.props;
---

<div
  id='page-config'
  data-api-url={apiUrl}
  style='display:none'
>
</div>

<script>
  // Read apiUrl safely from data attribute — avoids define:vars colon bug
  const apiUrl =
    document.getElementById("page-config")?.dataset?.apiUrl ||
    "http://localhost:3001";

  let product = null;
  let variants = [];
  let colors = [];
  let patterns = [];
  let selectedVariant = null;

  function getSlugFromPath() {
    const parts = window.location.pathname.split("/").filter(Boolean);
    return parts[1] || "";
  }

  function showSkeleton(show) {
    const skeleton = document.getElementById("product-skeleton");
    if (skeleton) skeleton.classList.toggle("hidden", !show);
  }

  function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function setImage(id, src, alt) {
    const el = document.getElementById(id);
    if (!el) return;
    el.src = src || "";
    el.alt = alt || "";
  }

  function updatePrice() {
    if (!selectedVariant || !product) return;
    const price = product.basePrice + selectedVariant.additionalPrice;
    setText("price-display", `₹${price}`);
    setText("sticky-price", `₹${price}`);
  }

  function updateStockStatus() {
    if (!selectedVariant) return;
    const stockElement = document.getElementById("stock-status");
    const stockCount = document.getElementById("stock-count");
    const quantityInput = document.getElementById("quantity-input");

    if (selectedVariant.stock > 0) {
      if (stockElement) {
        stockElement.className = "text-gray-600 font-medium";
        stockElement.textContent = "In Stock";
      }
      if (stockCount)
        stockCount.textContent = `${selectedVariant.stock} units available`;

      if (quantityInput) {
        const max = Math.max(1, Math.min(10, selectedVariant.stock));
        quantityInput.max = String(max);
        const current = parseInt(quantityInput.value) || 1;
        if (current > max) quantityInput.value = String(max);
      }
      setText("sticky-stock", "In Stock");
      const stickyBtn = document.getElementById("sticky-add-to-cart-btn");
      if (stickyBtn) { stickyBtn.disabled = false; stickyBtn.classList.remove("opacity-50", "cursor-not-allowed"); }
    } else {
      if (stockElement) {
        stockElement.className = "text-red-500 font-medium";
        stockElement.textContent = "Out of Stock";
      }
      if (stockCount) stockCount.textContent = "";

      if (quantityInput) {
        quantityInput.max = "1";
        quantityInput.value = "1";
      }
      setText("sticky-stock", "Out of Stock");
      const stickyBtn = document.getElementById("sticky-add-to-cart-btn");
      if (stickyBtn) { stickyBtn.disabled = true; stickyBtn.classList.add("opacity-50", "cursor-not-allowed"); }
    }
  }

  function updateAddToCartButton() {
    const button = document.getElementById("add-to-cart-btn");
    if (!button) return;
    if (selectedVariant && selectedVariant.stock > 0) {
      button.disabled = false;
      button.classList.remove(
        "bg-gray-300",
        "text-gray-500",
        "cursor-not-allowed",
      );
      button.classList.add("bg-gray-900", "text-white", "hover:bg-black");
    } else {
      button.disabled = true;
      button.classList.remove("bg-gray-900", "text-white", "hover:bg-black");
      button.classList.add(
        "bg-gray-300",
        "text-gray-500",
        "cursor-not-allowed",
      );
    }
  }

  function showImage(index) {
    const activeImages = selectedVariant?.images?.length
      ? selectedVariant.images
      : product?.images || [];
    if (!activeImages.length) return;

    const mainImage = document.getElementById("main-image");
    const thumbnails = document.querySelectorAll(".thumbnail");

    if (mainImage) mainImage.src = activeImages[index] || "";

    thumbnails.forEach((thumb, i) => {
      if (i === index) {
        thumb.classList.add("ring-2", "ring-gray-900");
      } else {
        thumb.classList.remove("ring-2", "ring-gray-900");
      }
    });
  }

  function updateVariant(color, pattern) {
    let variant = variants.find(
      (v) => v.color === color && v.pattern === pattern && v.isAvailable,
    );

    if (!variant) {
      variant = variants.find((v) => v.color === color && v.isAvailable);
    }
    if (!variant) {
      variant = variants.find((v) => v.pattern === pattern && v.isAvailable);
    }
    if (!variant) {
      variant = variants.find((v) => v.isAvailable) || variants[0];
    }

    if (!variant) return;

    selectedVariant = variant;
    setText("product-sku", selectedVariant.sku || "-");
    updatePrice();
    updateStockStatus();
    updateAddToCartButton();
    renderVariantGallery();

    const colorButtons = document.querySelectorAll(".color-option");
    const patternButtons = document.querySelectorAll(".pattern-option");
    setSelectedButton(
      colorButtons,
      Array.from(colorButtons).find(
        (btn) => btn.getAttribute("data-color") === selectedVariant.color,
      ),
    );
    setSelectedButton(
      patternButtons,
      Array.from(patternButtons).find(
        (btn) => btn.getAttribute("data-pattern") === selectedVariant.pattern,
      ),
    );
  }

  function renderVariantGallery() {
    if (!product) return;

    const activeImages = selectedVariant?.images?.length
      ? selectedVariant.images
      : product.images || [];

    setImage("main-image", activeImages[0] || "", product.name);

    const thumbnails = document.getElementById("image-thumbnails");
    if (thumbnails) {
      thumbnails.innerHTML = (activeImages || [])
        .map(
          (image, index) => `
          <img
            src="${image}"
            alt="${product.name} view ${index + 1}"
            class="thumbnail w-20 h-20 object-cover rounded cursor-pointer border-2 border-gray-200 hover:border-gray-900 transition-colors ${index === 0 ? "ring-2 ring-gray-900" : ""}"
            data-index="${index}"
            loading="lazy"
            decoding="async"
          />
        `,
        )
        .join("");

      thumbnails.querySelectorAll(".thumbnail").forEach((thumb) => {
        thumb.addEventListener("click", () =>
          showImage(parseInt(thumb.dataset.index)),
        );
      });
    }
  }

  function setSelectedButton(buttons, selectedButton) {
    buttons.forEach((btn) => {
      btn.classList.remove("selected", "border-gray-900", "bg-gray-50");
      btn.classList.add("border-gray-300");
    });
    if (selectedButton) {
      selectedButton.classList.add("selected", "border-gray-900", "bg-gray-50");
      selectedButton.classList.remove("border-gray-300");
    }
  }

  function renderNotFound() {
    showSkeleton(false);
    const content = document.getElementById("product-content");
    const notFound = document.getElementById("product-not-found");
    if (content) content.classList.add("hidden");
    if (notFound) notFound.classList.remove("hidden");
  }

  function renderProduct(productData) {
    showSkeleton(false);
    const content = document.getElementById("product-content");
    if (content) {
      content.classList.remove("hidden");
      content.classList.add("flex");
    }
    product = productData;
    variants = (product.variants || []).filter((v) => v.isAvailable);
    colors = [...new Set(variants.map((v) => v.color))];
    patterns = [...new Set(variants.map((v) => v.pattern))];

    const prices = variants.map((v) => product.basePrice + v.additionalPrice);
    const minPrice = Math.min(...prices);
    const maxPrice = Math.max(...prices);
    const priceDisplay =
      minPrice === maxPrice ? `₹${minPrice}` : `₹${minPrice} - ₹${maxPrice}`;
    const categoryLabel =
      typeof product.category === "string"
        ? product.category
        : product.category?.name || "";

    document.title = `${product.name} - Fashion Store`;
    setText("product-breadcrumb-name", product.name);
    setText("product-name", product.name);
    setText("price-display", priceDisplay);
    setText("product-description", product.description || "");
    setText("product-category", categoryLabel.replace("_", " "));
    setText("product-sku", variants[0]?.sku || "-");
    // Gallery is variant-driven (with product-level fallback)
    renderVariantGallery();

    const colorsWrap = document.getElementById("color-options");
    const colorLabel = colorsWrap?.previousElementSibling;
    if (colorsWrap) {
      if (colors.length > 1) {
        colorsWrap.innerHTML = colors
          .map(
            (color, idx) => `
            <button
              type="button"
              data-color="${color}"
              class="color-option py-2 px-4 rounded-md border-2 transition-colors ${idx === 0 ? "selected border-gray-900 bg-gray-50" : "border-gray-300"}"
            >
              ${color}
            </button>
          `,
          )
          .join("");
        colorsWrap.classList.remove("hidden");
        if (colorLabel) colorLabel.classList.remove("hidden");
      } else {
        colorsWrap.classList.add("hidden");
        if (colorLabel) colorLabel.classList.add("hidden");
      }
    }

    const patternsWrap = document.getElementById("pattern-options");
    if (patternsWrap) {
      patternsWrap.innerHTML = patterns
        .map(
          (pattern, idx) => `
          <button
            type="button"
            data-pattern="${pattern}"
            class="pattern-option py-2 px-4 rounded-md border-2 transition-colors ${idx === 0 ? "selected border-gray-900 bg-gray-50" : "border-gray-300"}"
          >
            ${pattern}
          </button>
        `,
        )
        .join("");
    }

    const firstAvailable = variants.find((v) => v.isAvailable) || variants[0];
    selectedVariant = firstAvailable || null;

    updatePrice();
    updateStockStatus();
    updateAddToCartButton();
    if (selectedVariant) {
      updateVariant(selectedVariant.color, selectedVariant.pattern);
    }

    const colorButtons = document.querySelectorAll(".color-option");
    const patternButtons = document.querySelectorAll(".pattern-option");

    if (colorButtons.length > 0) {
      const initialColor = selectedVariant?.color || colors[0];
      const initialColorButton = Array.from(colorButtons).find(
        (btn) => btn.getAttribute("data-color") === initialColor,
      );
      setSelectedButton(colorButtons, initialColorButton || colorButtons[0]);
    }

    if (patternButtons.length > 0) {
      const initialPattern = selectedVariant?.pattern || patterns[0];
      const initialPatternButton = Array.from(patternButtons).find(
        (btn) => btn.getAttribute("data-pattern") === initialPattern,
      );
      setSelectedButton(
        patternButtons,
        initialPatternButton || patternButtons[0],
      );
    }

	    colorButtons.forEach((button) => {
	      button.addEventListener("click", () => {
	        const selectedColor = button.getAttribute("data-color");
	        const currentPattern =
	          document
	            .querySelector(".pattern-option.selected")
	            ?.getAttribute("data-pattern") || patterns[0];
	        setSelectedButton(colorButtons, button);
	        if (selectedColor && currentPattern)
	          updateVariant(selectedColor, currentPattern);
	      });
	    });

    patternButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedPattern = button.getAttribute("data-pattern");
        const currentColor =
          document
            .querySelector(".color-option.selected")
            ?.getAttribute("data-color") || colors[0];
        setSelectedButton(patternButtons, button);
        if (selectedPattern && currentColor)
          updateVariant(currentColor, selectedPattern);
      });
    });

    const addToCartBtn = document.getElementById("add-to-cart-btn");
    if (addToCartBtn) addToCartBtn.addEventListener("click", addToCart);

    const stickyBtn = document.getElementById("sticky-add-to-cart-btn");
    if (stickyBtn) stickyBtn.addEventListener("click", addToCart);

    const quantityInput = document.getElementById("quantity-input");
    const decreaseBtn = document.getElementById("decrease-qty");
    const increaseBtn = document.getElementById("increase-qty");

    if (decreaseBtn && quantityInput) {
      decreaseBtn.addEventListener("click", () => {
        const currentValue = parseInt(quantityInput.value) || 1;
        if (currentValue > 1) quantityInput.value = currentValue - 1;
      });
    }

    if (increaseBtn && quantityInput) {
      increaseBtn.addEventListener("click", () => {
        const currentValue = parseInt(quantityInput.value) || 1;
        const maxValue = parseInt(quantityInput.max) || 10;
        if (currentValue < maxValue) quantityInput.value = currentValue + 1;
      });
    }
  }

  function showCartError(msg) {
    const el = document.getElementById("cart-message");
    if (!el) return;
    el.textContent = msg;
    el.className = "mb-4 p-3 bg-red-50 text-red-700 rounded-md text-sm";
    el.classList.remove("hidden");
    setTimeout(() => el.classList.add("hidden"), 3500);
  }

  function addToCart() {
    if (!product || !selectedVariant) {
      showCartError("This product is currently unavailable.");
      return;
    }

    const quantityInput = document.getElementById("quantity-input");
    const quantity = quantityInput ? parseInt(quantityInput.value) || 1 : 1;

    const maxAllowed = Math.max(0, Math.min(10, selectedVariant.stock || 0));
    if (maxAllowed <= 0) {
      showCartError("This variant is out of stock.");
      return;
    }
    if (quantity > maxAllowed) {
      showCartError(`Only ${maxAllowed} units available for this variant.`);
      if (quantityInput) quantityInput.value = String(maxAllowed);
      return;
    }

    const cartItem = {
      productId: product.id,
      variantId: selectedVariant.id,
      productName: product.name,
      productSlug: product.slug,
      productImage:
        selectedVariant.images?.[0] ||
        product.images?.[0] ||
        "",
      color: selectedVariant.color,
      pattern: selectedVariant.pattern,
      quantity: quantity,
      unitPrice: product.basePrice + selectedVariant.additionalPrice,
      totalPrice:
        (product.basePrice + selectedVariant.additionalPrice) * quantity,
    };

    let cart = JSON.parse(localStorage.getItem("cart") || "[]");

    const existingItemIndex = cart.findIndex(
      (item) =>
        item.productId === cartItem.productId &&
        item.variantId === cartItem.variantId,
    );

    if (existingItemIndex >= 0) {
      const nextQty = cart[existingItemIndex].quantity + quantity;
      if (nextQty > maxAllowed) {
        showCartError(`Only ${maxAllowed} units available. Your cart already has ${cart[existingItemIndex].quantity}.`);
        return;
      }
      cart[existingItemIndex].quantity = nextQty;
      cart[existingItemIndex].totalPrice =
        cart[existingItemIndex].quantity * cart[existingItemIndex].unitPrice;
    } else {
      cart.push(cartItem);
    }

    localStorage.setItem("cart", JSON.stringify(cart));

    window.dispatchEvent(
      new CustomEvent("cart:updated", {
        detail: { cart, timestamp: Date.now() },
      }),
    );
    window.dispatchEvent(
      new CustomEvent("cart:item-added", {
        detail: { item: cartItem, timestamp: Date.now() },
      }),
    );

    const message = document.getElementById("cart-message");
    if (message) {
      message.textContent = "Added to cart!";
      message.className = "mb-4 p-3 bg-green-50 text-green-800 rounded-md text-sm";
      message.classList.remove("hidden");
      setTimeout(() => message.classList.add("hidden"), 3000);
    }
  }

  async function loadProduct() {
    const slug = getSlugFromPath();
    if (!slug) return renderNotFound();
    try {
      const response = await fetch(
        `${apiUrl}/api/products/slug/${encodeURIComponent(slug)}`,
      );
      if (!response.ok) return renderNotFound();
      const found = await response.json();
      if (!found || !found.isActive) return renderNotFound();
      renderProduct(found);
    } catch (error) {
      console.error("Product fetch failed", error);
      renderNotFound();
    }
  }

	  function initProductPage() {
	    loadProduct();
	  }

	  if (document.readyState === "loading") {
	    document.addEventListener("DOMContentLoaded", initProductPage);
	  } else {
	    initProductPage();
	  }
	</script>

<!-- Sticky mobile Add to Cart bar -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 px-4 py-3 flex items-center gap-3">
  <div class="min-w-0">
    <div id="sticky-price" class="text-base font-bold text-gray-900">₹0</div>
    <div id="sticky-stock" class="text-xs text-gray-500">In Stock</div>
  </div>
  <button
    id="sticky-add-to-cart-btn"
    class="flex-1 bg-black text-white py-3 px-4 rounded-xl font-medium text-sm transition-colors active:bg-gray-800"
  >
    Add to Cart
  </button>
</div>

<div class='container mx-auto px-4 py-8 pb-24 lg:pb-8'>
  <style>
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
    }
    @keyframes shimmer {
      0% {
        background-position: -400px 0;
      }
      100% {
        background-position: 400px 0;
      }
    }
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 400px 100%;
      animation: shimmer 1.4s infinite;
      border-radius: 6px;
    }
  </style>
  <nav class='mb-6 text-sm'>
    <ol class='flex items-center space-x-2'>
      <li>
        <a
          href='/'
          class='text-gray-600 hover:text-black'
          >Home</a
        >
      </li>
      <li><span class='text-gray-500'>/</span></li>
      <li>
        <a
          href='/products'
          class='text-gray-600 hover:text-black'
          >Products</a
        >
      </li>
      <li><span class='text-gray-500'>/</span></li>
      <li
        id='product-breadcrumb-name'
        class='text-gray-700 font-medium'
      >
        Product
      </li>
    </ol>
  </nav>
  <!-- Loading Skeleton -->
  <div
    id='product-skeleton'
    class='flex flex-col lg:flex-row gap-8'
  >
    <!-- Image skeleton -->
    <div class='w-full lg:w-1/2'>
      <div class='bg-white rounded-lg shadow-md overflow-hidden'>
        <div class='skeleton w-full h-96'></div>
        <div class='flex p-4 space-x-2'>
          <div class='skeleton w-20 h-20 rounded'></div>
          <div class='skeleton w-20 h-20 rounded'></div>
          <div class='skeleton w-20 h-20 rounded'></div>
        </div>
      </div>
    </div>
    <!-- Details skeleton -->
    <div class='w-full lg:w-1/2'>
      <div class='bg-white rounded-lg shadow-md p-6 space-y-4'>
        <div class='skeleton h-8 w-3/4'></div>
        <div class='skeleton h-7 w-1/3'></div>
        <div class='skeleton h-5 w-1/4'></div>
        <div class='skeleton h-4 w-full'></div>
        <div class='skeleton h-4 w-5/6'></div>
        <div class='skeleton h-4 w-4/6'></div>
        <div class='space-y-2 pt-2'>
          <div class='skeleton h-4 w-16'></div>
          <div class='flex gap-2'>
            <div class='skeleton h-10 w-20 rounded-md'></div>
            <div class='skeleton h-10 w-20 rounded-md'></div>
          </div>
        </div>
        <div class='space-y-2'>
          <div class='skeleton h-4 w-16'></div>
          <div class='flex gap-2'>
            <div class='skeleton h-10 w-20 rounded-md'></div>
            <div class='skeleton h-10 w-20 rounded-md'></div>
          </div>
        </div>
        <div class='flex gap-4 pt-2'>
          <div class='skeleton h-12 flex-1 rounded-md'></div>
          <div class='skeleton h-12 flex-1 rounded-md'></div>
        </div>
      </div>
    </div>
  </div>

  <div
    id='product-content'
    class='hidden flex-col lg:flex-row gap-8'
  >
    <div class='w-full lg:w-1/2'>
      <div class='bg-white rounded-xl overflow-hidden border border-gray-100'>
        <div class='relative bg-gray-50'>
          <div class='aspect-square overflow-hidden'>
            <img
              id='main-image'
              src=''
              alt=''
              class='w-full h-full object-contain'
            />
          </div>
        </div>

        <div
          id='image-thumbnails'
          class='flex p-3 gap-2 overflow-x-auto scrollbar-hide'
        >
        </div>
      </div>
    </div>

    <div class='w-full lg:w-1/2'>
      <div class='bg-white rounded-xl border border-gray-100 p-5 lg:p-6'>
        <h1
          id='product-name'
          class='text-2xl font-bold mb-4'
        >
          Product
        </h1>

        <div class='mb-4'>
          <span
            id='price-display'
            class='text-2xl font-bold text-gray-900'
            >₹0</span
          >
        </div>

        <div class='mb-6'>
          <p
            id='stock-status'
            class='text-gray-600 font-medium'
          >
            In Stock
          </p>
          <p
            id='stock-count'
            class='text-sm text-gray-600'
          >
            0 units available
          </p>
        </div>

        <div class='mb-6'>
          <p
            id='product-description'
            class='text-gray-700'
          >
          </p>
        </div>

        <div class='mb-6'>
          <div class='mb-4'>
            <h3 class='font-medium mb-2'>Color</h3>
            <div
              id='color-options'
              class='flex flex-wrap gap-2'
            >
            </div>
          </div>

          <div class='mb-4'>
            <h3 class='font-medium mb-2'>Pattern</h3>
            <div
              id='pattern-options'
              class='flex flex-wrap gap-2'
            >
            </div>
          </div>
        </div>

        <div class='mb-6'>
          <h3 class='font-medium mb-2'>Quantity</h3>
          <div class='flex items-center space-x-3'>
            <button
              id='decrease-qty'
              class='w-10 h-10 rounded-md border-2 border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M20 12H4'
                ></path>
              </svg>
            </button>
            <input
              id='quantity-input'
              type='number'
              min='1'
              max='10'
              value='1'
              class='w-20 text-center border-2 border-gray-300 rounded-md py-2 font-medium focus:outline-none focus:border-gray-900'
            />
            <button
              id='increase-qty'
              class='w-10 h-10 rounded-md border-2 border-gray-300 flex items-center justify-center hover:bg-gray-100 transition-colors'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='h-5 w-5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M12 4v16m8-8H4'
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <div class='flex flex-col sm:flex-row gap-4 mb-6'>
          <button
            id='add-to-cart-btn'
            class='flex-1 bg-gray-900 text-white py-3 px-6 rounded-md font-medium hover:bg-black transition-colors'
          >
            Add to Cart
          </button>

          <a
            href='/products'
            class='flex-1 bg-gray-200 text-gray-800 py-3 px-6 rounded-md font-medium hover:bg-gray-300 transition-colors text-center'
          >
            Continue Shopping
          </a>
        </div>

        <div
          id='cart-message'
          class='hidden mb-4 p-3 bg-green-100 text-green-800 rounded-md'
        >
          Item added to cart!
        </div>

        <div class='border-t pt-6'>
          <h3 class='font-medium mb-3'>Product Details</h3>
          <ul class='space-y-2 text-sm text-gray-600'>
            <li>SKU: <span id='product-sku'>-</span></li>
            <li>Category: <span id='product-category'>-</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div
    id='product-not-found'
    class='hidden'
  >
